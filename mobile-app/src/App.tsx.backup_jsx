      <main className="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
        
        {/* TAB 1: INTERACTIVE MOBILE SIMULATOR */}
        {activeTab === 'preview' && (
          <div className="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
            
            {/* Left Column: Screen Navigator & Status Monitor */}
            <div className="lg:col-span-5 space-y-6">
              <div className="bg-gradient-to-br from-indigo-950/60 via-slate-900 to-slate-900 border border-indigo-500/30 rounded-2xl p-5 space-y-4">
                <div className="inline-flex items-center gap-2 px-2.5 py-1 rounded-md text-xs font-semibold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
                  <Sparkles className="w-3.5 h-3.5" /> Status da Implementação
                </div>

                <h2 className="text-lg font-bold text-white tracking-tight">
                  Telas do Módulo REST em Ação
                </h2>
                <p className="text-xs text-slate-300 leading-relaxed">
