                <button
                  onClick={() => handleCopy(`import 'dart:convert';
import 'package:flutter/foundation.dart';
import 'package:shared_preferences/shared_preferences.dart';
import 'package:http/http.dart' as http;
import '../models/product_model.dart';

/// Repositório de Produtos com Caching Offline-First (Stale-While-Revalidate)
/// Usa SharedPreferences / Hive para guardar o catálogo localmente
class ProductRepository extends ChangeNotifier {
  static const String _cacheKey = 'cached_products_list_v1';
  static const String _apiEndpoint = 'https://api.karegaaki.co.mz/api/v1/products';

  List<Product> _products = [];
  bool _isLoading = false;
  bool _isOfflineMode = false;
  String? _errorMessage;

  List<Product> get products => _products;
  bool get isLoading => _isLoading;
  bool get isOfflineMode => _isOfflineMode;
  String? get errorMessage => _errorMessage;

  /// Padrão Stale-While-Revalidate:
  /// 1. Carrega imediatamente os dados do cache local (SharedPreferences / Hive).
  /// 2. Notifica a UI para renderizar instantaneamente sem ecrã em branco.
  /// 3. Executa o pedido HTTP em segundo plano para obter atualizações do servidor.
  /// 4. Atualiza o cache local e emite uma nova notificação para a UI.
  Future<void> fetchProductsWithCache() async {
    // 1. Carregar do cache local imediatamente
    await _loadFromLocalCache();

    // 2. Procurar dados atualizados do servidor REST
    await _fetchFromRemoteServer();
  }

  /// Lê do SharedPreferences
  Future<void> _loadFromLocalCache() async {
    try {
      final prefs = await SharedPreferences.getInstance();
      final String? jsonString = prefs.getString(_cacheKey);

      if (jsonString != null && jsonString.isNotEmpty) {
        final List<dynamic> decodedJson = jsonDecode(jsonString);
        _products = decodedJson.map((item) => Product.fromJson(item)).toList();
        _isOfflineMode = true; // Indica que são dados armazenados localmente
        notifyListeners();
        debugPrint('⚡ Caching: \${_products.length} produtos carregados do cache local.');
      }
    } catch (e) {
      debugPrint('Erro ao ler cache de produtos: $e');
    }
  }

  /// Procura atualizações no servidor REST e atualiza o cache
  Future<void> _fetchFromRemoteServer() async {
    _isLoading = true;
    notifyListeners();

    try {
      final response = await http.get(
        Uri.parse(_apiEndpoint),
        headers: {'Accept': 'application/json'},
      ).timeout(const Duration(seconds: 8));

      if (response.statusCode == 200) {
        final List<dynamic> decodedJson = jsonDecode(response.body);
        _products = decodedJson.map((item) => Product.fromJson(item)).toList();
        _isOfflineMode = false;
        _errorMessage = null;

        // Atualizar o Cache Local no SharedPreferences
        final prefs = await SharedPreferences.getInstance();
        await prefs.setString(_cacheKey, jsonEncode(decodedJson));
        debugPrint('✅ Caching: Cache local atualizado com dados novos do servidor.');
      } else {
        _errorMessage = 'Servidor respondeu com código \${response.statusCode}';
      }
    } catch (e) {
      // Se a rede falhar, a app continua a exibir os produtos do cache local
      _errorMessage = 'Sem rede. A exibir dados do cache local.';
      debugPrint('Rede offline ou erro no servidor: $e');
    } finally {
      _isLoading = false;
      notifyListeners();
    }
  }

  /// Limpar o cache local
  Future<void> clearCache() async {
    final prefs = await SharedPreferences.getInstance();
    await prefs.remove(_cacheKey);
    _products = [];
    notifyListeners();
  }
}`, 'product_repository_caching_code')}
                  className="px-2.5 py-1 bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-mono rounded flex items-center gap-1 cursor-pointer"
                >
                  {copiedKey === 'product_repository_caching_code' ? <Check className="w-3.5 h-3.5 text-emerald-400" /> : <Copy className="w-3.5 h-3.5" />} Copiar
                </button>
              </div>
              <pre className="bg-slate-950 p-4 rounded-xl text-xs font-mono text-emerald-300 overflow-x-auto max-h-60">
{`import 'dart:convert';
import 'package:shared_preferences/shared_preferences.dart';
import 'package:http/http.dart' as http;

// Repositório de Caching Stale-While-Revalidate:
// 1. _loadFromLocalCache() -> Carrega SharedPreferences('cached_products_list_v1')
// 2. notifyListeners() -> Exibe produtos imediatamente na UI
// 3. _fetchFromRemoteServer() -> GET /api/v1/products
// 4. prefs.setString(...) + notifyListeners() -> Atualiza com novos preços/produtos`}
              </pre>
