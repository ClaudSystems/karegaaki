                    <td className="p-2.5">/api/v1/wallet/history</td>
                    <td className="p-2.5 font-sans">Listar movimentos da carteira (Crédito, Débito, Bónus)</td>
                    <td className="p-2.5 text-emerald-400 font-bold">✅ Pronto</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        )}

      </main>

      {/* Footer */}
      <footer className="border-t border-slate-800 bg-slate-950 py-6 text-center text-xs text-slate-500">
        <div className="max-w-7xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-4">
          <div>
            KaregaAki Mobile • Projeto em <code className="text-slate-400">W:\KaregaAki\mobile-app</code>
          </div>
          <div className="text-slate-400">
            Todos os módulos REST mapeados e prontos
          </div>
        </div>
      </footer>
    </div>
  );
}
