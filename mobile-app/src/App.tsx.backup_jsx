                <button
                  onClick={() => handleCopy(`import 'package:flutter/material.dart';
import '../../../core/api/api_client.dart';
import '../../../core/notifications/notification_service.dart';

class CheckoutScreen extends StatefulWidget {
  final String productId;
  final String productName;
  final double creditPrice;

  const CheckoutScreen({
    super.key,
    required this.productId,
    required this.productName,
    required this.creditPrice,
  });

  @override
  State<CheckoutScreen> createState() => _CheckoutScreenState();
}

class _CheckoutScreenState extends State<CheckoutScreen> {
  bool _isProcessing = false;

  Future<void> _processCheckout() async {
    if (_isProcessing) return; // Prevenção de duplo clique

    setState(() => _isProcessing = true);

    // Apresenta o Dialog com indicador de progresso enquanto a transação é processada
    showDialog(
      context: context,
      barrierDismissible: false,
      builder: (ctx) => AlertDialog(
        backgroundColor: Colors.grey[900],
        shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(16)),
        content: Padding(
          padding: const EdgeInsets.symmetric(vertical: 12.0),
          child: Row(
            children: [
              const CircularProgressIndicator(color: Colors.emeraldAccent),
              const SizedBox(width: 20),
              Expanded(
                child: Text(
                  'A processar compra no backend...',
                  style: const TextStyle(color: Colors.white, fontSize: 14),
                ),
              ),
            ],
          ),
        ),
      ),
    );

    final api = ApiClient();
    try {
      final res = await api.dio.post('/transactions/checkout', data: {
        'items': [
          {'product_id': widget.productId, 'quantity': 1}
        ]
      });

      if (!mounted) return;
      Navigator.pop(context); // Fecha o Dialog de progresso

      final items = res.data['items'] as List?;
      final code = (items != null && items.isNotEmpty) ? items[0]['code_delivered'] : 'N/A';

      // Dispara a notificação local de código entregue
      await NotificationService().showCodeDeliveredNotification(
        productName: widget.productName,
        code: code,
      );

      // Apresenta modal de sucesso com o código entregue
      showDialog(
        context: context,
        builder: (ctx) => AlertDialog(
          backgroundColor: Colors.grey[900],
          title: const Text('Compra Efetuada com Sucesso! 🎁', style: TextStyle(color: Colors.white, fontSize: 16)),
          content: Column(
            mainAxisSize: MainAxisSize.min,
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              Text('O seu código de resgate para \${widget.productName}:', style: const TextStyle(color: Colors.grey, fontSize: 13)),
              const SizedBox(height: 10),
              Container(
                padding: const EdgeInsets.all(12),
                decoration: BoxDecoration(
                  color: Colors.black45,
                  borderRadius: BorderRadius.circular(8),
                  border: Border.all(color: Colors.amberAccent.withOpacity(0.5)),
                ),
                child: SelectableText(
                  code,
                  style: const TextStyle(
                    color: Colors.amberAccent,
                    fontWeight: FontWeight.bold,
                    fontSize: 16,
                    fontFamily: 'monospace',
                  ),
                ),
              ),
            ],
          ),
          actions: [
            ElevatedButton(
              onPressed: () {
                Navigator.pop(ctx);
                Navigator.pop(context); // Regressa ao ecrã anterior / histórico
              },
              child: const Text('Concluído'),
            ),
          ],
        ),
      );
    } catch (e) {
      if (!mounted) return;
      Navigator.pop(context); // Fecha o Dialog de progresso
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text('Falha ao processar checkout: $e'),
          backgroundColor: Colors.red,
        ),
      );
    } finally {
      if (mounted) {
        setState(() => _isProcessing = false);
      }
    }
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: const Text('Confirmar Compra')),
      body: Padding(
        padding: const EdgeInsets.all(16.0),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Card(
              color: Colors.grey[900],
              shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(16)),
              child: Padding(
                padding: const EdgeInsets.all(16.0),
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Text(
                      widget.productName,
                      style: const TextStyle(fontSize: 18, fontWeight: FontWeight.bold, color: Colors.white),
                    ),
                    const SizedBox(height: 8),
                    Text(
                      'Preço: \${widget.creditPrice.toStringAsFixed(2)} cr',
                      style: const TextStyle(color: Colors.emeraldAccent, fontWeight: FontWeight.bold),
                    ),
                  ],
                ),
              ),
            ),
            const Spacer(),
            SizedBox(
              width: double.infinity,
              height: 50,
              child: ElevatedButton(
                // Botão bloqueado quando _isProcessing é verdadeiro (prevenção de duplo clique)
                onPressed: _isProcessing ? null : _processCheckout,
                style: ElevatedButton.styleFrom(
                  backgroundColor: Theme.of(context).primaryColor,
                  shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(12)),
                ),
                child: _isProcessing
                    ? const Row(
                        mainAxisAlignment: MainAxisAlignment.center,
                        children: [
                          SizedBox(
                            width: 18,
                            height: 18,
                            child: CircularProgressIndicator(color: Colors.white, strokeWidth: 2),
                          ),
                          SizedBox(width: 10),
                          Text('A processar...'),
                        ],
                      )
                    : const Text(
                        'Confirmar Compra (POST /checkout)',
                        style: TextStyle(fontWeight: FontWeight.bold, fontSize: 15),
                      ),
              ),
            ),
          ],
        ),
      ),
    );
  }
}`, 'checkout_code')}
                  className="px-2.5 py-1 bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-mono rounded flex items-center gap-1 cursor-pointer"
                >
                  {copiedKey === 'checkout_code' ? <Check className="w-3.5 h-3.5 text-emerald-400" /> : <Copy className="w-3.5 h-3.5" />} Copiar
                </button>
              </div>
              <pre className="bg-slate-950 p-4 rounded-xl text-xs font-mono text-emerald-300 overflow-x-auto max-h-60">
{`import 'package:flutter/material.dart';
import '../../../core/api/api_client.dart';

class CheckoutScreen extends StatefulWidget { ...
  // Bloqueio de duplo clique (_isProcessing) + Progress Dialog + POST /transactions/checkout
}`}
