                <button
                  onClick={() => handleCopy(`import 'package:flutter/material.dart';
import 'package:flutter_secure_storage/flutter_secure_storage.dart';
import '../screens/login_screen.dart';

class AuthProvider extends ChangeNotifier {
  final FlutterSecureStorage _secureStorage = const FlutterSecureStorage();
  
  bool _isAuthenticated = true;
  String? _jwtToken;
  Map<String, dynamic>? _user;

  bool get isAuthenticated => _isAuthenticated;
  String? get jwtToken => _jwtToken;
  Map<String, dynamic>? get user => _user;

  /// Método de Logout da Conta
  /// 1. Elimina os dados e tokens guardados no FlutterSecureStorage
  /// 2. Reseta o estado interno de autenticação no AuthProvider
  /// 3. Redireciona o utilizador para a LoginScreen limpando a pilha de navegação
  Future<void> logout(BuildContext context) async {
    try {
      // 1. Apagar token JWT e credenciais no armazenamento seguro
      await _secureStorage.delete(key: 'jwt_token');
      await _secureStorage.delete(key: 'user_session');

      // 2. Limpar o estado do AuthProvider
      _isAuthenticated = false;
      _jwtToken = null;
      _user = null;

      notifyListeners();

      // 3. Redirecionar para o ecrã de Login e remover todas as rotas anteriores
      if (context.mounted) {
        Navigator.pushAndRemoveUntil(
          context,
          MaterialPageRoute(builder: (context) => const LoginScreen()),
          (route) => false,
        );

        ScaffoldMessenger.of(context).showSnackBar(
          const SnackBar(
            content: Text('Sessão encerrada com sucesso.'),
            backgroundColor: Colors.black87,
            behavior: SnackBarBehavior.floating,
          ),
        );
      }
    } catch (e) {
      debugPrint('Erro ao efetuar logout: $e');
    }
  }
}`, 'auth_provider_logout_code')}
