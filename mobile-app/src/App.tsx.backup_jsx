const CREDIT_PACKAGES: CreditPackage[] = [
  { id: 'pkg-1', name: 'Básico', amount_mzn: 50, credit_received: 5, bonus_credit: 0 },
  { id: 'pkg-2', name: 'Popular', amount_mzn: 100, credit_received: 10, bonus_credit: 1, is_popular: true },
  { id: 'pkg-3', name: 'Económico', amount_mzn: 250, credit_received: 25, bonus_credit: 3 },
  { id: 'pkg-4', name: 'Premium', amount_mzn: 500, credit_received: 55, bonus_credit: 5 }
];

export default function App() {
  const [activeTab, setActiveTab] = useState<'preview' | 'dart_export' | 'rest_doc'>('preview');
  const [showConnectionTest, setShowConnectionTest] = useState(true); // ← ADICIONE ESTA LINHA

  // Mobile App View Screen

  const [mobileScreen, setMobileScreen] = useState<'auth' | 'catalog' | 'credits' | 'checkout' | 'history' | 'kyc' | 'wallet' | 'product_detail' | 'order_success' | 'cart' | 'create_dispute' | 'disputes_list'>('catalog');


  const [showTest, setShowTest] = useState(true); // true = visível
  // Main Navigation Tabs

  // Mobile App View Screen

  const [selectedDetailProduct, setSelectedDetailProduct] = useState<Product | null>(INITIAL_PRODUCTS[0]);

  // Last Completed Order State for Order Success Screen
  const [lastCompletedOrder, setLastCompletedOrder] = useState<{
    product_name: string;
    code_delivered: string;
    reference: string;
    credit_price: string;
  } | null>({
    product_name: 'Gift Card Netflix 25 USD',
    code_delivered: 'KAREGA-NETFL-991204',
    reference: '#TX-20260808-01',
    credit_price: '28.00'
  });

  // WhatsApp Share Handler (Partilha de Compra via WhatsApp)
  const handleWhatsAppShare = (productName: string, code: string) => {
    const message = `🎁 Comprei na KaregaAki!\n\nProduto: ${productName}\nCódigo: ${code}\n\nBaixa a app: https://karegaaki.co.mz`;
    const encoded = encodeURIComponent(message);
    const whatsappUrl = `https://wa.me/?text=${encoded}`;
    window.open(whatsappUrl, '_blank');
    triggerLocalNotification(
      'A abrir o WhatsApp... 💬',
      `Mensagem pré-formatada do produto ${productName} pronta para ser enviada.`
    );
  };

  // Product Caching State (Stale-While-Revalidate pattern via SharedPreferences / Hive)
  const [cacheStatus, setCacheStatus] = useState<'cached' | 'syncing' | 'synced'>('cached');
  const [lastSyncTime, setLastSyncTime] = useState<string>('06:05 (Cache Local)');

  const handleRefreshProductsServer = () => {
    setCacheStatus('syncing');
    triggerLocalNotification(
      'A sincronizar catálogo... 🔄',
      'A procurar novos produtos e preços atualizados no servidor REST...'
    );
    setTimeout(() => {
      setCacheStatus('synced');
      const now = new Date();
      const timeStr = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}:${String(now.getSeconds()).padStart(2, '0')}`;
      setLastSyncTime(`${timeStr} (Servidor)`);
      triggerLocalNotification(
        'Catálogo Atualizado! ✅',
        '8 produtos recebidos do servidor e guardados em cached_products_v1 no SharedPreferences / Hive.'
      );
    }, 1200);
  };

  const handleClearProductCache = () => {
    setCacheStatus('cached');
    setLastSyncTime('Cache Inicial Restaurado');
    triggerLocalNotification(
      'Cache Limpo 🧹',
      'Chave \'cached_products_v1\' limpa do SharedPreferences/Hive.'
    );
  };

  // --- STATE DATA ---
  const [user, setUser] = useState<UserProfile>({
    id: 'usr-88192',
    phone: '841234567',
    full_name: 'Cláudio Silva',
    kyc_level: 'Básico',
    limit_mzn: 500,
    daily_tx_limit: 5,
    is_verified: false
  });

  const [balanceCredit, setBalanceCredit] = useState<number>(45.00);
  const [selectedCategory, setSelectedCategory] = useState<string>('cat-all');
  const [searchQuery, setSearchQuery] = useState<string>('');
  const [sortBy, setSortBy] = useState<'name' | 'price_asc' | 'price_desc'>('name');
  
  // Checkout & Transactions State
  const [cartProduct, setCartProduct] = useState<Product | null>(INITIAL_PRODUCTS[0]);
  const [transactions, setTransactions] = useState<Transaction[]>([
    {
      id: 'tx-1001',
      reference: '#TX-20260807-001',
      total_credit: 55.00,
      payment_status: 'confirmed',
      delivery_status: 'delivered',
      payment_method: 'credit',
      created_at: '2026-08-07T12:00:00',
      items: [
        {
          product_id: 'a7b2e7e5-5f39-48f6-bb62-a37bc1ad7e0e',
          product_name: 'Gift Card Amazon 50 USD',
          quantity: 1,
          unit_credit_price: 55.00,
          code_delivered: 'KAREGA-AMZ-88912X4F'
        }
      ]
    }
  ]);

  // Shopping Cart Items State
  const [cartItems, setCartItems] = useState<CartItem[]>([
    { product: INITIAL_PRODUCTS[3], quantity: 2 }, // Gift Card Steam 20 USD (2x)
    { product: INITIAL_PRODUCTS[2], quantity: 1 }  // Gift Card Google Play 10 USD (1x)
  ]);

  // Disputes & Reclamações State
  const [disputes, setDisputes] = useState<Dispute[]>([
    {
      id: 'dis-1',
      reference: '#DIS-20260808-001',
      transaction_id: 'tx-1001',
      transaction_ref: '#TX-20260807-001',
      dispute_type: 'code_not_received',
      description: 'O código do Gift Card Amazon não funcionou na minha conta.',
      status: 'under_review',
      created_at: '2026-08-08T05:30:00',
      admin_response: 'Estamos a verificar junto do fornecedor o estado da chave.'
    }
  ]);

  // New Dispute Form State
  const [disputeTxId, setDisputeTxId] = useState<string>('');
  const [disputeType, setDisputeType] = useState<Dispute['dispute_type']>('payment_not_confirmed');
  const [disputeDesc, setDisputeDesc] = useState<string>('');

  // Cart Helper Methods
  const addToCart = (product: Product, quantity = 1) => {
    if (product.stock_available <= 0) {
      alert('Produto esgotado no fornecedor!');
      return;
    }
    setCartItems(prev => {
      const idx = prev.findIndex(item => item.product.id === product.id);
      if (idx > -1) {
        const copy = [...prev];
        copy[idx].quantity += quantity;
        return copy;
      }
      return [...prev, { product, quantity }];
    });
    triggerLocalNotification(
      'Adicionado ao Carrinho 🛒',
      `${product.name} (x${quantity}) adicionado ao seu carrinho.`
    );
  };

  const removeFromCart = (productId: string) => {
    setCartItems(prev => prev.filter(item => item.product.id !== productId));
  };

  const updateCartQuantity = (productId: string, delta: number) => {
    setCartItems(prev =>
      prev.map(item => {
        if (item.product.id === productId) {
          const newQty = item.quantity + delta;
          return newQty > 0 ? { ...item, quantity: newQty } : item;
        }
        return item;
      })
    );
  };

  const clearCart = () => {
    setCartItems([]);
  };

  const getProductCreditPriceNum = (product: Product): number => {
    const parsed = parseFloat(product.credit_price);
    return isNaN(parsed) ? 0 : parsed;
  };

  const cartTotalCredits = cartItems.reduce(
    (sum, item) => sum + getProductCreditPriceNum(item.product) * item.quantity,
    0
  );

  const totalCartCount = cartItems.reduce((sum, item) => sum + item.quantity, 0);

  // Multi-item Cart Checkout Handler
  const handleMultipleCartCheckout = () => {
    if (cartItems.length === 0) return;

    if (balanceCredit < cartTotalCredits) {
      alert(`Saldo insuficiente em créditos! Tens ${balanceCredit.toFixed(2)} cr mas a compra requer ${cartTotalCredits.toFixed(2)} cr.`);
      return;
    }

    setIsCheckoutProcessing(true);

    setTimeout(() => {
      const newRef = `#TX-20260808-00${transactions.length + 1}`;
      const txItems: TransactionItem[] = cartItems.map(item => ({
        product_id: item.product.id,
        product_name: item.product.name,
        quantity: item.quantity,
        unit_credit_price: getProductCreditPriceNum(item.product),
        code_delivered: `KAREGA-${item.product.slug.substring(0, 5).toUpperCase()}-${Math.floor(100000 + Math.random() * 900000)}`
      }));

      const newTx: Transaction = {
        id: `tx-${Date.now()}`,
        reference: newRef,
        total_credit: cartTotalCredits,
        payment_status: 'confirmed',
        delivery_status: 'delivered',
        payment_method: 'credit',
        items: txItems,
        created_at: new Date().toISOString()
      };

      setBalanceCredit(prev => prev - cartTotalCredits);
      setTransactions(prev => [newTx, ...prev]);

      setWalletMovements(prev => [
        {
          id: `wm-${Date.now()}`,
          type: 'purchase_spent',
          amount: -cartTotalCredits,
          description: `Checkout Múltiplo (${txItems.length} produtos)`,
          created_at: 'Hoje, Agora'
        },
        ...prev
      ]);

      const codesSummary = txItems.map(i => `${i.product_name} (x${i.quantity}): ${i.code_delivered}`).join('\n');

      setLastCompletedOrder({
        product_name: txItems.length === 1 ? txItems[0].product_name : `Carrinho Múltiplo (${txItems.length} Itens)`,
        code_delivered: codesSummary,
        reference: newRef,
        credit_price: cartTotalCredits.toFixed(2)
      });

      clearCart();
      setIsCheckoutProcessing(false);
      setMobileScreen('order_success');

      triggerLocalNotification(
        'Compra Múltipla Efetuada! 🛒',
        `Transação ${newRef} confirmada. ${txItems.length} códigos de resgate entregues!`
      );
    }, 1800);
  };

  // Dispute submission
  const handleCreateDisputeSubmit = () => {
    if (!disputeDesc.trim()) {
      alert('Por favor descreva o problema.');
      return;
    }

    const refNum = `#DIS-20260808-00${disputes.length + 1}`;
    const matchedTx = transactions.find(t => t.id === disputeTxId || t.reference === disputeTxId);

    const newDispute: Dispute = {
      id: `dis-${Date.now()}`,
      reference: refNum,
      transaction_id: matchedTx?.id || (disputeTxId ? disputeTxId : undefined),
      transaction_ref: matchedTx?.reference || (disputeTxId ? disputeTxId : undefined),
      dispute_type: disputeType,
      description: disputeDesc,
      status: 'open',
      created_at: new Date().toISOString()
    };

    setDisputes(prev => [newDispute, ...prev]);
    setDisputeDesc('');
    setDisputeTxId('');
    setMobileScreen('disputes_list');

    triggerLocalNotification(
      'Reclamação Registada! 📋',
      `Reclamação ${refNum} submetida com sucesso. Analisaremos em breve.`
    );
  };

  // Wallet Movements
  const [walletMovements, setWalletMovements] = useState<WalletMovement[]>([
    { id: 'wm-1', type: 'credit_purchase', amount: 60.0, description: 'Recarga via M-Pesa (#CRE-001)', created_at: '2026-08-07 10:15' },
    { id: 'wm-2', type: 'purchase_spent', amount: -15.0, description: 'Compra Gift Card Google Play', created_at: '2026-08-07 11:30' },
  ]);

  // Credits Purchase State
  const [selectedPackage, setSelectedPackage] = useState<CreditPackage>(CREDIT_PACKAGES[1]);
  const [purchaseRef, setPurchaseRef] = useState<string | null>(null);
  const [purchaseStatus, setPurchaseStatus] = useState<'idle' | 'pending' | 'confirmed'>('idle');


  // Checkout Processing State
  const [isCheckoutProcessing, setIsCheckoutProcessing] = useState<boolean>(false);

  // Local Notifications Simulation
  const [localNotification, setLocalNotification] = useState<{ title: string; body: string } | null>(null);

  const triggerLocalNotification = (title: string, body: string) => {
    setLocalNotification({ title, body });
    setTimeout(() => {
      setLocalNotification(null);
    }, 6000);
  };

  // ApiClient Interceptor Error Simulation (Dio 403 / 500)
  const [interceptorError, setInterceptorError] = useState<{
    code: 403 | 500;
    title: string;
    message: string;
  } | null>(null);

  const triggerInterceptorError = (code: 403 | 500) => {
    if (code === 403) {
      setInterceptorError({
        code: 403,
        title: 'Acesso Negado (HTTP 403)',
        message: 'Acesso não autorizado ou limite KYC excedido para esta transação. Por favor, verifique a sua conta.'
      });
    } else {
      setInterceptorError({
        code: 500,
        title: 'Erro de Servidor (HTTP 500)',
        message: 'Ocorreu uma falha interna nos servidores do KaregaAki. Por favor, tente novamente mais tarde.'
      });
    }
    setTimeout(() => {
      setInterceptorError(null);
    }, 6000);
  };

  // KYC Form State
  const [biInput, setBiInput] = useState<string>('');
  const [kycSubmitted, setKycSubmitted] = useState<boolean>(false);

  // Auth Form State
  const [authMode, setAuthMode] = useState<'login' | 'register'>('login');
  const [authPhone, setAuthPhone] = useState<string>('841234567');
  const [authPin, setAuthPin] = useState<string>('1234');
  const [isLoggedIn, setIsLoggedIn] = useState<boolean>(true);

  // Copy helper
  const [copiedKey, setCopiedKey] = useState<string | null>(null);
  const handleCopy = (text: string, key: string) => {
    navigator.clipboard.writeText(text);
    setCopiedKey(key);
    setTimeout(() => setCopiedKey(null), 2000);
  };

  // Filtered Products
  const filteredProducts = INITIAL_PRODUCTS.filter(p => {
    const matchesCat = selectedCategory === 'cat-all' || p.category_id === selectedCategory;
    const matchesSearch = p.name.toLowerCase().includes(searchQuery.toLowerCase()) || p.description.toLowerCase().includes(searchQuery.toLowerCase());
    return matchesCat && matchesSearch;
  }).sort((a, b) => {
    if (sortBy === 'price_asc') return parseFloat(a.credit_price) - parseFloat(b.credit_price);
    if (sortBy === 'price_desc') return parseFloat(b.credit_price) - parseFloat(a.credit_price);
    return a.name.localeCompare(b.name);
  });

  return (
      {/* Teste de Conexão Backend */}
  {showConnectionTest && (
      <div style={{
        position: 'fixed',
        top: '10px',
        right: '10px',
        zIndex: 99999,
        width: '300px',
        boxShadow: '0 4px 20px rgba(0,0,0,0.5)',
        borderRadius: '12px',
        overflow: 'hidden',
      }}>
        <ConnectionTest />
        <button
            onClick={() => setShowConnectionTest(false)}
            style={{
              position: 'absolute',
              top: '15px',
              right: '15px',
              background: '#ef4444',
              color: 'white',
              border: 'none',
              borderRadius: '50%',
              width: '24px',
              height: '24px',
              cursor: 'pointer',
              fontSize: '14px',
              display: 'flex',
              alignItems: 'center',
              justifyContent: 'center',
              zIndex: 2,
              lineHeight: 1,
              padding: 0,
            }}
            title="Fechar teste"
        >
          ✕
        </button>
      </div>
  )}
    <div className="min-h-screen bg-slate-950 text-slate-100 flex flex-col font-sans selection:bg-indigo-500 selection:text-white">
      {/* Header */}
      <header className="border-b border-slate-800 bg-slate-900/90 backdrop-blur sticky top-0 z-50">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
          <div className="flex items-center gap-3">
            <div className="w-9 h-9 rounded-xl bg-gradient-to-tr from-indigo-500 to-cyan-500 flex items-center justify-center text-white shadow-lg shadow-indigo-500/20">
              <Smartphone className="w-5 h-5" />
            </div>
            <div>
              <div className="flex items-center gap-2">
                <h1 className="text-base font-bold text-white leading-none">KaregaAki — Execução Completa REST</h1>
                <span className="text-[10px] px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-300 font-mono border border-emerald-500/30">
                  Todas as Funcionalidades ✅
                </span>
              </div>
              <p className="text-xs text-slate-400 mt-1">Créditos, Checkout, Carteira, KYC & Autenticação Flutter</p>
            </div>
          </div>

          <div className="flex items-center gap-1.5 bg-slate-950 p-1 rounded-xl border border-slate-800">
            <button
