                </p>

                <div className="space-y-2">
                  {[
                    { id: 'auth', title: '1. Autenticação (Login / Registro)', path: '/auth/login & /auth/me', icon: User },
                    { id: 'catalog', title: '2. Produtos & Categorias', path: '/products & /products/categories', icon: ShoppingBag },
                    { id: 'cart', title: '3. Carrinho de Compras 🛒', path: '/cart & /transactions/checkout', icon: ShoppingCart },
                    { id: 'credits', title: '4. Compra de Créditos M-Pesa', path: '/credits/packages & /credits/purchase', icon: CreditCard },
                    { id: 'checkout', title: '5. Checkout & Transação', path: '/transactions/checkout', icon: Zap },
                    { id: 'history', title: '6. Histórico de Compras', path: '/transactions & /transactions/{id}', icon: History },
                    { id: 'disputes_list', title: '7. Reclamações & Disputas 📋', path: '/disputes & /disputes/{id}', icon: HelpCircle },
                    { id: 'kyc', title: '8. Perfil & Verificação KYC', path: '/kyc/status & /kyc/submit', icon: UserCheck },
                    { id: 'wallet', title: '9. Carteira & Movimentos', path: '/wallet/balance & /wallet/history', icon: Wallet },
                  ].map((item) => {
                    const IconComp = item.icon;
                    const isActive = mobileScreen === item.id;
                    return (
                      <button
                        key={item.id}
                        onClick={() => setMobileScreen(item.id as any)}
                        className={`w-full text-left p-3 rounded-xl transition flex items-center justify-between border cursor-pointer ${
                          isActive
                            ? 'bg-indigo-600/20 border-indigo-500 text-white shadow-lg'
                            : 'bg-slate-950/80 border-slate-800/80 text-slate-400 hover:text-slate-200 hover:bg-slate-800/50'
                        }`}
                      >
                        <div className="flex items-center gap-3">
                          <div className={`p-2 rounded-lg ${isActive ? 'bg-indigo-600 text-white' : 'bg-slate-800 text-slate-400'}`}>
                            <IconComp className="w-4 h-4" />
                          </div>
                          <div>
                            <div className="text-xs font-bold">{item.title}</div>
                            <div className="text-[10px] font-mono text-slate-500">{item.path}</div>
                          </div>
                        </div>
                        <ChevronRight className={`w-4 h-4 ${isActive ? 'text-indigo-400' : 'text-slate-600'}`} />
                      </button>
                    );
                  })}
                </div>
              </div>

              {/* User Balance Overview Box */}
              <div className="bg-slate-900 border border-slate-800 rounded-2xl p-5 space-y-3">
                <div className="flex items-center justify-between text-xs font-bold text-white">
                  <span className="flex items-center gap-2">
                    <Wallet className="w-4 h-4 text-emerald-400" /> Estado Atual da Sessão
                  </span>
                  <span className="text-emerald-400 font-mono">{balanceCredit.toFixed(2)} Créditos</span>
                </div>

                <div className="grid grid-cols-2 gap-2 text-xs font-mono pt-2 border-t border-slate-800">
                  <div className="bg-slate-950 p-2.5 rounded-lg border border-slate-800">
                    <div className="text-[10px] text-slate-500 uppercase">Utilizador</div>
                    <div className="text-slate-200 truncate">{user.full_name}</div>
                  </div>
                  <div className="bg-slate-950 p-2.5 rounded-lg border border-slate-800">
                    <div className="text-[10px] text-slate-500 uppercase">Nível KYC</div>
                    <div className="text-indigo-400 font-bold">{user.kyc_level}</div>
                  </div>
                </div>
              </div>

              {/* Test ApiClient Error Interceptor Box */}
              <div className="bg-slate-900 border border-slate-800 rounded-2xl p-5 space-y-3">
                <div className="flex items-center justify-between text-xs font-bold text-white">
                  <span className="flex items-center gap-2">
                    <ShieldAlert className="w-4 h-4 text-amber-400" /> Interceptor Global ApiClient (Dio)
                  </span>
                  <span className="text-[10px] font-mono text-slate-400">403 & 500</span>
                </div>
                <p className="text-[11px] text-slate-400">
                  Simule a captura automática de erros HTTP globais interceptados pelo client Dio no Flutter:
                </p>
                <div className="grid grid-cols-2 gap-2 pt-1">
                  <button
                    onClick={() => triggerInterceptorError(403)}
                    className="py-2 px-3 bg-amber-950/80 hover:bg-amber-900 border border-amber-800/80 text-amber-300 rounded-xl font-mono text-[11px] font-bold flex items-center justify-center gap-1.5 cursor-pointer transition"
                  >
                    <AlertTriangle className="w-3.5 h-3.5" /> Erro 403
                  </button>
                  <button
                    onClick={() => triggerInterceptorError(500)}
                    className="py-2 px-3 bg-red-950/80 hover:bg-red-900 border border-red-800/80 text-red-300 rounded-xl font-mono text-[11px] font-bold flex items-center justify-center gap-1.5 cursor-pointer transition"
                  >
                    <ServerCrash className="w-3.5 h-3.5" /> Erro 500
                  </button>
                </div>
              </div>

              {/* Test Product Stock Verification Box */}
              <div className="bg-slate-900 border border-slate-800 rounded-2xl p-5 space-y-3">
                <div className="flex items-center justify-between text-xs font-bold text-white">
                  <span className="flex items-center gap-2">
                    <ShoppingBag className="w-4 h-4 text-emerald-400" /> Verificação de Stock (ProductDetailScreen)
                  </span>
                  <span className="text-[10px] font-mono text-slate-400">Stock = 0</span>
                </div>
                <p className="text-[11px] text-slate-400">
                  Teste a navegação para o ecrã de detalhes de um produto disponível vs. um produto com stock 0 (botão desabilitado + rótulo 'Esgotado'):
                </p>
                <div className="grid grid-cols-2 gap-2 pt-1">
                  <button
                    onClick={() => {
                      const inStockItem = INITIAL_PRODUCTS.find(p => p.stock_available > 0) || INITIAL_PRODUCTS[1];
                      setSelectedDetailProduct(inStockItem);
                      setMobileScreen('product_detail');
                    }}
                    className="py-2 px-2 bg-emerald-950/80 hover:bg-emerald-900 border border-emerald-800/80 text-emerald-300 rounded-xl font-mono text-[10px] font-bold flex items-center justify-center gap-1 cursor-pointer transition"
                  >
                    <CheckCircle className="w-3.5 h-3.5 text-emerald-400" /> Stock {'>'} 0 (Comprar)
                  </button>
                  <button
                    onClick={() => {
                      const outOfStockItem = INITIAL_PRODUCTS.find(p => p.stock_available === 0) || INITIAL_PRODUCTS[0];
                      setSelectedDetailProduct(outOfStockItem);
                      setMobileScreen('product_detail');
                    }}
                    className="py-2 px-2 bg-red-950/80 hover:bg-red-900 border border-red-800/80 text-red-300 rounded-xl font-mono text-[10px] font-bold flex items-center justify-center gap-1 cursor-pointer transition"
                  >
                    <Ban className="w-3.5 h-3.5 text-red-400" /> Stock = 0 ('Esgotado')
                  </button>
                </div>
              </div>

              {/* Test WhatsApp Share Box */}
              <div className="bg-slate-900 border border-slate-800 rounded-2xl p-5 space-y-3">
                <div className="flex items-center justify-between text-xs font-bold text-white">
                  <span className="flex items-center gap-2">
                    <MessageSquare className="w-4 h-4 text-emerald-400" /> Partilha de Compra via WhatsApp
                  </span>
                  <span className="text-[10px] font-mono text-emerald-400 bg-emerald-950/80 px-2 py-0.5 rounded border border-emerald-800/80">
                    KaregaAki Viral
                  </span>
                </div>
                <p className="text-[11px] text-slate-400">
                  Abre o ecrã de confirmação de compra e a partilha do código de resgate com mensagem pré-formatada no WhatsApp:
                </p>
                <div className="grid grid-cols-2 gap-2 pt-1">
                  <button
                    onClick={() => {
                      setLastCompletedOrder({
                        product_name: "Gift Card Netflix 25 USD",
                        code_delivered: "KAREGA-NETFL-991204",
                        reference: "#TX-20260808-01",
                        credit_price: "28.00"
                      });
                      setMobileScreen('order_success');
                    }}
                    className="py-2 px-2 bg-indigo-950/80 hover:bg-indigo-900 border border-indigo-800/80 text-indigo-300 rounded-xl font-mono text-[10px] font-bold flex items-center justify-center gap-1 cursor-pointer transition"
                  >
                    <Gift className="w-3.5 h-3.5 text-indigo-400" /> Ecrã de Sucesso
                  </button>
                  <button
                    onClick={() => handleWhatsAppShare("Gift Card Netflix 25 USD", "KAREGA-NETFL-991204")}
                    className="py-2 px-2 bg-emerald-950/80 hover:bg-emerald-900 border border-emerald-800/80 text-emerald-300 rounded-xl font-mono text-[10px] font-bold flex items-center justify-center gap-1 cursor-pointer transition"
                  >
                    <MessageSquare className="w-3.5 h-3.5 text-emerald-400" /> WhatsApp Direto
                  </button>
                </div>
              </div>

              {/* Test Product Cache Box */}
              <div className="bg-slate-900 border border-slate-800 rounded-2xl p-5 space-y-3">
                <div className="flex items-center justify-between text-xs font-bold text-white">
                  <span className="flex items-center gap-2">
                    <Database className="w-4 h-4 text-indigo-400" /> Cache de Produtos (Stale-While-Revalidate)
                  </span>
                  <span className="text-[10px] font-mono text-indigo-400 bg-indigo-950/80 px-2 py-0.5 rounded border border-indigo-800/80">
                    SharedPreferences / Hive
                  </span>
                </div>
                <p className="text-[11px] text-slate-400">
                  A app exibe o catálogo em cache local instantaneamente ao abrir e sincroniza novos preços do servidor em segundo plano:
                </p>
                <div className="grid grid-cols-2 gap-2 pt-1">
                  <button
                    onClick={handleRefreshProductsServer}
                    disabled={cacheStatus === 'syncing'}
                    className="py-2 px-2 bg-indigo-950/80 hover:bg-indigo-900 border border-indigo-800/80 text-indigo-300 rounded-xl font-mono text-[10px] font-bold flex items-center justify-center gap-1 cursor-pointer transition disabled:opacity-50"
                  >
                    <RefreshCw className={`w-3.5 h-3.5 text-indigo-400 ${cacheStatus === 'syncing' ? 'animate-spin' : ''}`} /> Atualizar Servidor
                  </button>
                  <button
                    onClick={handleClearProductCache}
                    className="py-2 px-2 bg-slate-950 hover:bg-slate-800 border border-slate-800 text-slate-300 rounded-xl font-mono text-[10px] font-bold flex items-center justify-center gap-1 cursor-pointer transition"
                  >
                    <HardDrive className="w-3.5 h-3.5 text-slate-400" /> Limpar Cache
                  </button>
                </div>
              </div>
            </div>

            {/* Right Column: Mobile Frame */}
            <div className="lg:col-span-7 flex justify-center">
              <div className="w-full max-w-[390px] bg-slate-900 border-[8px] border-slate-800 rounded-[44px] shadow-2xl flex flex-col overflow-hidden relative min-h-[680px]">
                
                {/* Phone Top Notch Bar */}
                <div className="bg-slate-950 px-6 pt-3 pb-2 flex items-center justify-between text-[11px] font-medium text-slate-400 border-b border-slate-800/80">
                  <span>09:41</span>
                  <div className="w-16 h-3 bg-slate-800 rounded-full"></div>
                  <div className="flex items-center gap-1.5">
                    <span className="text-[9px] font-mono text-emerald-400">4G LTE</span>
                    <div className="w-4 h-2 bg-slate-300 rounded-xs"></div>
                  </div>
                </div>

                {/* Simulated Push Notification Banner (flutter_local_notifications) */}
                {localNotification && (
                  <div className="absolute top-10 left-3 right-3 z-50 bg-slate-900/95 border border-indigo-500/50 rounded-2xl p-3 shadow-2xl backdrop-blur-md animate-in slide-in-from-top-4 duration-300">
                    <div className="flex items-start gap-2.5">
                      <div className="w-7 h-7 rounded-lg bg-indigo-600 flex items-center justify-center text-white shrink-0 mt-0.5">
                        <Sparkles className="w-4 h-4 text-amber-300" />
                      </div>
                      <div className="flex-1 min-w-0">
                        <div className="flex items-center justify-between">
                          <span className="text-[10px] font-bold text-indigo-300 uppercase tracking-wider">flutter_local_notifications</span>
                          <span className="text-[9px] text-slate-500 font-mono">agora</span>
                        </div>
                        <div className="text-xs font-bold text-white leading-tight mt-0.5">{localNotification.title}</div>
                        <div className="text-[11px] text-slate-300 truncate mt-0.5">{localNotification.body}</div>
                      </div>
                      <button onClick={() => setLocalNotification(null)} className="text-slate-500 hover:text-white text-xs font-bold cursor-pointer">✕</button>
                    </div>
                  </div>
                )}

                {/* Simulated Dio Global Interceptor Error Snackbar (403 / 500) */}
                {interceptorError && (
                  <div className={`absolute bottom-16 left-3 right-3 z-50 rounded-2xl p-3.5 shadow-2xl border backdrop-blur-md animate-in slide-in-from-bottom-4 duration-300 ${
                    interceptorError.code === 403
                      ? 'bg-amber-950/95 border-amber-500/60 text-amber-200'
                      : 'bg-red-950/95 border-red-500/60 text-red-200'
                  }`}>
                    <div className="flex items-start gap-2.5">
                      <div className={`w-8 h-8 rounded-xl flex items-center justify-center shrink-0 ${
                        interceptorError.code === 403 ? 'bg-amber-600 text-amber-950' : 'bg-red-600 text-white'
                      }`}>
                        {interceptorError.code === 403 ? <AlertTriangle className="w-5 h-5" /> : <ServerCrash className="w-5 h-5" />}
                      </div>
                      <div className="flex-1 min-w-0">
                        <div className="flex items-center justify-between">
                          <span className="text-[10px] font-bold uppercase tracking-wider font-mono opacity-80">
                            ApiClient Interceptor
                          </span>
                          <span className="text-[9px] font-bold font-mono px-1.5 py-0.5 rounded bg-black/40">
                            HTTP {interceptorError.code}
                          </span>
                        </div>
                        <div className="text-xs font-bold leading-tight mt-0.5 text-white">{interceptorError.title}</div>
                        <div className="text-[11px] opacity-90 leading-snug mt-1">{interceptorError.message}</div>
                      </div>
                      <button onClick={() => setInterceptorError(null)} className="opacity-60 hover:opacity-100 text-xs font-bold cursor-pointer">✕</button>
                    </div>
                  </div>
                )}

                {/* Mobile App Bar */}
                <div className="bg-slate-950 px-4 py-3 border-b border-slate-800 flex items-center justify-between">
                  <div className="flex items-center gap-2">
                    <div className="w-7 h-7 rounded-lg bg-indigo-600 flex items-center justify-center text-white font-bold text-xs shadow-md shadow-indigo-600/30">
                      K
                    </div>
                    <div>
                      <h3 className="text-xs font-bold text-white leading-tight">KaregaAki Mobile</h3>
                      <p className="text-[10px] text-slate-400 capitalize">{mobileScreen.replace('_', ' ')}</p>
                    </div>
                  </div>

                  <div className="flex items-center gap-1.5">
                    <button
                      onClick={() => setMobileScreen('disputes_list')}
                      className={`relative p-1.5 rounded-lg border cursor-pointer transition ${
                        mobileScreen === 'disputes_list' || mobileScreen === 'create_dispute'
                          ? 'bg-amber-500/20 border-amber-500/50 text-amber-300'
                          : 'bg-slate-900 border-slate-800 text-slate-400 hover:text-slate-200'
                      }`}
                      title="Minhas Reclamações / Disputas"
                    >
                      <HelpCircle className="w-4 h-4" />
                      {disputes.length > 0 && (
                        <span className="absolute -top-1 -right-1 w-2 h-2 rounded-full bg-amber-500 animate-pulse" />
                      )}
                    </button>

                    <button
                      onClick={() => setMobileScreen('cart')}
                      className={`relative p-1.5 rounded-lg border cursor-pointer transition ${
                        mobileScreen === 'cart'
                          ? 'bg-indigo-600/30 border-indigo-500 text-indigo-300'
                          : 'bg-slate-900 border-slate-800 text-slate-400 hover:text-slate-200'
                      }`}
                      title="Carrinho de Compras"
                    >
                      <ShoppingCart className="w-4 h-4" />
                      {totalCartCount > 0 && (
                        <span className="absolute -top-1.5 -right-1.5 bg-indigo-600 text-white font-bold text-[9px] rounded-full w-4 h-4 flex items-center justify-center border border-slate-950 shadow-sm">
                          {totalCartCount}
                        </span>
                      )}
                    </button>

                    <button
                      onClick={() => setMobileScreen('wallet')}
                      className="px-2.5 py-1 bg-emerald-500/10 border border-emerald-500/20 rounded-lg text-[11px] font-bold text-emerald-400 cursor-pointer hover:bg-emerald-500/20 transition"
                    >
                      {balanceCredit.toFixed(2)} cr
                    </button>
                  </div>
                </div>

                {/* Mobile Viewport Body */}
                <div className="flex-1 bg-slate-950 p-4 space-y-4 overflow-y-auto">
                  
                  {/* SCREEN 1: AUTH */}
                  {mobileScreen === 'auth' && (
                    <div className="space-y-4 text-xs">
                      <div className="text-center space-y-1 py-2">
                        <div className="w-12 h-12 rounded-2xl bg-indigo-600 text-white font-bold text-xl flex items-center justify-center mx-auto shadow-lg shadow-indigo-600/30">
                          K
                        </div>
                        <h3 className="text-sm font-bold text-white">Bem-vindo ao KaregaAki</h3>
                        <p className="text-slate-400 text-[11px]">Entra com o teu telefone e PIN de 4 dígitos</p>
                      </div>

                      <div className="bg-slate-900 p-4 rounded-2xl border border-slate-800 space-y-3">
                        <div className="flex rounded-lg bg-slate-950 p-1 border border-slate-800 text-[11px]">
                          <button
                            onClick={() => setAuthMode('login')}
                            className={`flex-1 py-1 rounded-md font-bold cursor-pointer transition ${authMode === 'login' ? 'bg-indigo-600 text-white' : 'text-slate-400'}`}
                          >
                            Entrar (Login)
                          </button>
                          <button
                            onClick={() => setAuthMode('register')}
                            className={`flex-1 py-1 rounded-md font-bold cursor-pointer transition ${authMode === 'register' ? 'bg-indigo-600 text-white' : 'text-slate-400'}`}
                          >
                            Registar
                          </button>
                        </div>

                        <div className="space-y-2">
                          <label className="text-[10px] text-slate-400 font-bold uppercase">Telefone M-Pesa</label>
                          <input
                            type="text"
                            value={authPhone}
                            onChange={(e) => setAuthPhone(e.target.value)}
                            className="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-white"
                            placeholder="841234567"
                          />
                        </div>

                        <div className="space-y-2">
                          <label className="text-[10px] text-slate-400 font-bold uppercase">PIN Secreto (4 Dígitos)</label>
                          <input
                            type="password"
                            maxLength={4}
                            value={authPin}
                            onChange={(e) => setAuthPin(e.target.value)}
                            className="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-white tracking-widest text-center font-bold"
                            placeholder="••••"
                          />
                        </div>

                        <button
                          onClick={() => {
                            setIsLoggedIn(true);
                            setUser(prev => ({ ...prev, phone: authPhone }));
                            setMobileScreen('catalog');
                          }}
                          className="w-full py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white font-bold rounded-xl transition cursor-pointer shadow-lg shadow-indigo-600/30 flex items-center justify-center gap-2"
                        >
                          <span>{authMode === 'login' ? 'Entrar na Conta' : 'Criar Conta KaregaAki'}</span>
                          <span className="text-indigo-200">➔</span>
                        </button>
                      </div>
                    </div>
                  )}

                  {/* SCREEN 2: PRODUCTS & CATEGORIES */}
                  {mobileScreen === 'catalog' && (
                    <div className="space-y-3 text-xs">
                      {/* Cache Status Badge (Stale-While-Revalidate) */}
                      <div className="bg-slate-900 border border-slate-800 rounded-xl p-2.5 flex items-center justify-between text-[11px] font-mono">
                        <div className="flex items-center gap-2 min-w-0">
                          <div className={`w-2 h-2 rounded-full shrink-0 ${cacheStatus === 'syncing' ? 'bg-amber-400 animate-ping' : cacheStatus === 'synced' ? 'bg-emerald-400' : 'bg-indigo-400'}`} />
                          <div className="min-w-0">
                            <div className="font-bold text-slate-200 truncate flex items-center gap-1">
                              {cacheStatus === 'cached' && <span>⚡ Cache Local: <b>8 Produtos</b></span>}
                              {cacheStatus === 'syncing' && <span className="text-amber-300">🔄 A sincronizar servidor...</span>}
                              {cacheStatus === 'synced' && <span className="text-emerald-300">✅ Catálogo Atualizado</span>}
                            </div>
                            <div className="text-[9px] text-slate-400 truncate">{lastSyncTime}</div>
                          </div>
                        </div>
                        <button
                          onClick={handleRefreshProductsServer}
                          disabled={cacheStatus === 'syncing'}
                          className="px-2 py-1 bg-indigo-950 hover:bg-indigo-900 border border-indigo-800/80 text-indigo-300 rounded-lg text-[10px] font-bold flex items-center gap-1 shrink-0 cursor-pointer disabled:opacity-50"
                        >
                          <RefreshCw className={`w-3 h-3 ${cacheStatus === 'syncing' ? 'animate-spin' : ''}`} /> Sync
                        </button>
                      </div>

                      {/* Promo Hero Banner */}
                      <div className="bg-gradient-to-r from-indigo-900 via-indigo-950 to-slate-900 border border-indigo-500/40 rounded-2xl p-3.5 space-y-1.5 shadow-lg relative overflow-hidden">
                        <div className="absolute top-0 right-0 w-24 h-24 bg-indigo-500/10 rounded-full blur-xl pointer-events-none" />
                        <div className="flex items-center gap-1.5 text-amber-400 text-[10px] font-bold uppercase tracking-wider">
                          <Sparkles className="w-3.5 h-3.5" /> KaregaAki Moçambique
                        </div>
                        <h3 className="text-xs font-bold text-white leading-snug">
                          Recarrega M-Pesa & Compra Vouchers Digitais Instantâneos!
                        </h3>
                        <p className="text-[10px] text-slate-300">
                          Entrega de códigos imediata com confirmação por WhatsApp.
                        </p>
                      </div>

                      {/* Search Bar */}
                      <div className="relative">
                        <Search className="w-3.5 h-3.5 absolute left-3 top-3 text-slate-500" />
                        <input
                          type="text"
                          placeholder="Pesquisar gift cards, M-Pesa..."
                          value={searchQuery}
                          onChange={(e) => setSearchQuery(e.target.value)}
                          className="w-full bg-slate-900 border border-slate-800 rounded-xl pl-8 pr-3 py-2 text-xs text-slate-200"
                        />
                      </div>

                      {/* Categories list */}
                      <div className="flex items-center gap-1.5 overflow-x-auto pb-1 scrollbar-none">
                        {CATEGORIES.map(cat => (
                          <button
                            key={cat.id}
                            onClick={() => setSelectedCategory(cat.id)}
                            className={`px-3 py-1 rounded-lg text-[10px] font-semibold whitespace-nowrap cursor-pointer transition ${
                              selectedCategory === cat.id
                                ? 'bg-indigo-600 text-white'
                                : 'bg-slate-900 text-slate-400 border border-slate-800'
                            }`}
                          >
                            {cat.name}
                          </button>
                        ))}
                      </div>

                      {/* Products Grid */}
                      <div className="space-y-2.5">
                        {filteredProducts.map(product => {
                          const isOutOfStock = product.stock_available <= 0;
                          return (
                            <div
                              key={product.id}
                              onClick={() => {
                                setSelectedDetailProduct(product);
                                setMobileScreen('product_detail');
                              }}
                              className={`bg-slate-900 border rounded-xl p-3 flex gap-3 cursor-pointer transition ${
                                isOutOfStock ? 'border-red-900/40 opacity-90 hover:border-red-700/60' : 'border-slate-800/90 hover:border-slate-700'
                              }`}
                            >
                              <div className="relative shrink-0">
                                <img
                                  src={product.image_url}
                                  alt={product.name}
                                  className="w-13 h-13 rounded-lg object-cover bg-slate-800"
                                />
                                {isOutOfStock && (
                                  <div className="absolute inset-0 bg-black/60 rounded-lg flex items-center justify-center">
                                    <span className="text-[8px] font-black text-red-400 uppercase tracking-tighter bg-red-950/90 px-1 py-0.5 rounded border border-red-800">
                                      Esgotado
                                    </span>
                                  </div>
                                )}
                              </div>
                              <div className="flex-1 flex flex-col justify-between min-w-0">
                                <div>
                                  <div className="flex items-center justify-between gap-1">
                                    <span className="text-[9px] font-bold text-indigo-400 uppercase truncate">
                                      {product.category_name}
                                    </span>
                                    {isOutOfStock ? (
                                      <span className="text-[9px] font-bold text-red-400 bg-red-950/80 px-1.5 py-0.5 rounded border border-red-800 shrink-0">
                                        0 em Stock
                                      </span>
                                    ) : (
                                      <span className="text-[10px] text-slate-500 shrink-0">Stock: {product.stock_available}</span>
                                    )}
                                  </div>
                                  <h4 className="text-xs font-bold text-white line-clamp-1 mt-0.5">{product.name}</h4>
                                </div>

                                <div className="flex items-center justify-between pt-1">
                                  <span className="text-xs font-bold text-emerald-400">
                                    {product.credit_price} cr
                                  </span>
                                  <div className="flex items-center gap-1.5">
                                    {!isOutOfStock && (
                                      <button
                                        onClick={(e) => {
                                          e.stopPropagation();
                                          addToCart(product, 1);
                                        }}
                                        className="px-2 py-1 bg-indigo-950/80 hover:bg-indigo-900 border border-indigo-700/80 text-indigo-300 rounded-lg text-[10px] font-bold flex items-center gap-1 cursor-pointer transition shadow-sm"
                                        title="Adicionar ao Carrinho"
                                      >
                                        <ShoppingCart className="w-3 h-3 text-indigo-400" /> + Carrinho
                                      </button>
                                    )}
                                    <button
                                      onClick={(e) => {
                                        e.stopPropagation();
                                        setSelectedDetailProduct(product);
                                        setMobileScreen('product_detail');
                                      }}
                                      className={`px-2.5 py-1 rounded-lg text-[10px] font-bold cursor-pointer transition ${
                                        isOutOfStock
                                          ? 'bg-red-950/90 hover:bg-red-900 text-red-300 border border-red-800/80'
                                          : 'bg-indigo-600 hover:bg-indigo-500 text-white'
                                      }`}
                                    >
                                      {isOutOfStock ? 'Esgotado' : 'Ver'}
                                    </button>
                                  </div>
                                </div>
                              </div>
                            </div>
                          );
                        })}
                      </div>
                    </div>
                  )}

                  {/* SCREEN 3: CREDITS PURCHASE */}
                  {mobileScreen === 'credits' && (
                    <div className="space-y-4 text-xs">
                      <div className="font-bold text-white flex items-center justify-between">
                        <span>Recarregar Créditos (M-Pesa)</span>
                        <span className="text-[10px] text-slate-400 font-mono">POST /credits/purchase</span>
                      </div>

                      <div className="space-y-2">
                        {CREDIT_PACKAGES.map(pkg => (
                          <div
                            key={pkg.id}
                            onClick={() => setSelectedPackage(pkg)}
                            className={`p-3 rounded-xl border cursor-pointer transition flex items-center justify-between ${
                              selectedPackage.id === pkg.id
                                ? 'bg-indigo-600/20 border-indigo-500 text-white shadow-md'
                                : 'bg-slate-900 border-slate-800 text-slate-300'
                            }`}
                          >
                            <div>
                              <div className="font-bold">{pkg.name} ({pkg.credit_received} cr)</div>
                              <div className="text-[10px] text-emerald-400">+{pkg.bonus_credit} cr Bónus</div>
                            </div>
                            <div className="text-right">
                              <div className="font-bold text-indigo-300">{pkg.amount_mzn}.00 MZN</div>
                              {pkg.is_popular && (
                                <span className="text-[8px] bg-amber-500/20 text-amber-300 px-1.5 py-0.5 rounded font-bold">Mais Popular</span>
                              )}
                            </div>
                          </div>
                        ))}
                      </div>

                      {purchaseStatus === 'idle' && (
                        <button
                          onClick={() => {
                            const ref = `#CRE-${new Date().toISOString().slice(0,10).replace(/-/g,'')}-0${Math.floor(Math.random()*90+10)}`;
                            setPurchaseRef(ref);
                            setPurchaseStatus('pending');
                          }}
                          className="w-full py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white rounded-xl font-bold transition cursor-pointer"
                        >
                          Gerar Instruções M-Pesa
                        </button>
                      )}

                      {purchaseStatus === 'pending' && (
                        <div className="p-3.5 bg-slate-900 border border-slate-800 rounded-2xl space-y-3">
                          <div className="text-amber-400 font-bold flex items-center gap-1.5">
                            <Clock className="w-4 h-4 animate-pulse" /> Pagamento Pendente
                          </div>
                          <p className="text-[11px] text-slate-300 leading-relaxed bg-slate-950 p-3 rounded-xl font-mono border border-slate-800">
                            Envie <strong>{selectedPackage.amount_mzn}.00 MZN</strong> para <strong>84XXXXXXX</strong> com a referência <strong className="text-amber-300">{purchaseRef}</strong>
                          </p>

                          <button
                            onClick={() => {
                              const totalCreds = selectedPackage.credit_received + selectedPackage.bonus_credit;
                              setBalanceCredit(prev => prev + totalCreds);
                              setWalletMovements(prev => [
                                {
                                  id: `wm-${Date.now()}`,
                                  type: 'credit_purchase',
                                  amount: totalCreds,
                                  description: `Recarga via M-Pesa (${purchaseRef})`,
                                  created_at: 'Hoje, Agora'
                                },
                                ...prev
                              ]);
                              setPurchaseStatus('confirmed');
                              triggerLocalNotification(
                                'Recarga Confirmada! 💳',
                                `Foram creditados ${totalCreds} cr na sua carteira KaregaAki.`
                              );
                            }}
                            className="w-full py-2 bg-emerald-600 hover:bg-emerald-500 text-white rounded-xl font-bold cursor-pointer"
                          >
                            Simular Webhook Confirmado
                          </button>
                        </div>
                      )}

                      {purchaseStatus === 'confirmed' && (
                        <div className="p-4 bg-emerald-500/10 border border-emerald-500/30 rounded-2xl text-center space-y-2">
                          <CheckCircle className="w-8 h-8 text-emerald-400 mx-auto" />
                          <div className="font-bold text-emerald-300">Créditos Creditados!</div>
                          <p className="text-[11px] text-slate-300">
                            Foram adicionados <strong>{selectedPackage.credit_received + selectedPackage.bonus_credit} cr</strong> ao seu saldo.
                          </p>
                          <button
                            onClick={() => setPurchaseStatus('idle')}
                            className="px-3 py-1.5 bg-slate-800 text-white rounded-lg text-[10px] font-bold cursor-pointer"
                          >
                            Voltar
                          </button>
                        </div>
                      )}
                    </div>
                  )}

                  {/* SCREEN 4: CHECKOUT */}
                  {mobileScreen === 'checkout' && cartProduct && (
                    <div className="space-y-4 text-xs relative">
                      <div className="font-bold text-white">Confirmar Compra</div>

                      <div className="p-3.5 bg-slate-900 border border-slate-800 rounded-2xl space-y-3">
                        <div className="flex gap-3 items-center">
                          <img src={cartProduct.image_url} className="w-12 h-12 rounded-lg object-cover" />
                          <div>
                            <div className="font-bold text-white">{cartProduct.name}</div>
                            <div className="text-[10px] text-slate-400">{cartProduct.category_name}</div>
                          </div>
                        </div>

                        <div className="pt-2 border-t border-slate-800 space-y-1">
                          <div className="flex justify-between text-slate-300">
                            <span>Preço em Créditos:</span>
                            <span className="font-bold text-emerald-400">{cartProduct.credit_price} cr</span>
                          </div>
                          <div className="flex justify-between text-slate-300">
                            <span>Seu Saldo Disponível:</span>
                            <span className="font-bold text-white">{balanceCredit.toFixed(2)} cr</span>
                          </div>
                        </div>
                      </div>

                      <button
                        disabled={isCheckoutProcessing}
                        onClick={() => {
                          if (isCheckoutProcessing) return;
                          const cost = parseFloat(cartProduct.credit_price);
                          if (balanceCredit >= cost) {
                            setIsCheckoutProcessing(true);
                            
                            // Simulate backend processing delay & atomic transaction
                            setTimeout(() => {
                              setBalanceCredit(prev => prev - cost);
                              const code = `KAREGA-${cartProduct.slug.substring(0, 5).toUpperCase()}-${Math.floor(100000 + Math.random() * 900000)}`;
                              
                              const newTx: Transaction = {
                                id: `tx-${Date.now()}`,
                                reference: `#TX-20260807-0${transactions.length + 1}`,
                                total_credit: cost,
                                payment_status: 'confirmed',
                                delivery_status: 'delivered',
                                payment_method: 'credit',
                                created_at: 'Hoje, Agora',
                                items: [{
                                  product_id: cartProduct.id,
                                  product_name: cartProduct.name,
                                  quantity: 1,
                                  unit_credit_price: cost,
                                  code_delivered: code
                                }]
                              };

                              setTransactions(prev => [newTx, ...prev]);
                              setWalletMovements(prev => [
                                {
                                  id: `wm-${Date.now()}`,
                                  type: 'purchase_spent',
                                  amount: -cost,
                                  description: `Compra ${cartProduct.name}`,
                                  created_at: 'Hoje, Agora'
                                },
                                ...prev
                              ]);

                              triggerLocalNotification(
                                'Código Entregue com Sucesso! 🎁',
                                `Código para ${cartProduct.name}: ${code}`
                              );

                              setLastCompletedOrder({
                                product_name: cartProduct.name,
                                code_delivered: code,
                                reference: newTx.reference,
                                credit_price: cartProduct.credit_price
                              });
                              setIsCheckoutProcessing(false);
                              setMobileScreen('order_success');
                            }, 1800);
                          } else {
                            alert('Saldo insuficiente em créditos! Faça uma recarga no ecrã de Créditos.');
                          }
                        }}
                        className={`w-full py-2.5 font-bold rounded-xl transition flex items-center justify-center gap-2 ${
                          isCheckoutProcessing
                            ? 'bg-slate-800 text-slate-500 cursor-not-allowed opacity-80 border border-slate-700'
                            : 'bg-indigo-600 hover:bg-indigo-500 text-white cursor-pointer'
                        }`}
                      >
                        {isCheckoutProcessing ? (
                          <>
                            <div className="w-3.5 h-3.5 border-2 border-indigo-400 border-t-transparent rounded-full animate-spin" />
                            <span>A Processar... (Bloqueado)</span>
                          </>
                        ) : (
                          <span>Confirmar Compra e Entregar Código ➔</span>
                        )}
                      </button>

                      {/* Backend Processing Dialog Overlay inside Simulator */}
                      {isCheckoutProcessing && (
                        <div className="absolute -inset-4 bg-slate-950/90 backdrop-blur-sm z-50 flex items-center justify-center p-4 rounded-3xl animate-in fade-in duration-200">
                          <div className="bg-slate-900 border border-indigo-500/30 rounded-2xl p-5 text-center space-y-3 shadow-2xl max-w-[240px]">
                            <div className="w-10 h-10 border-3 border-indigo-500 border-t-transparent rounded-full animate-spin mx-auto" />
                            <div>
                              <div className="font-bold text-white text-xs">A Processar Compra...</div>
                              <div className="text-[10px] text-slate-400 mt-1">A comunicar com o backend KaregaAki e a reservar o código no fornecedor...</div>
                            </div>
                            <div className="text-[9px] text-emerald-400 font-mono bg-emerald-950/80 border border-emerald-800/50 py-1 px-2 rounded-lg">
                              POST /api/v1/transactions/checkout
                            </div>
                          </div>
                        </div>
                      )}
                    </div>
                  )}

                  {/* SCREEN 5: HISTORY */}
                  {mobileScreen === 'history' && (
                    <div className="space-y-3 text-xs">
                      <div className="font-bold text-white">Minhas Compras ({transactions.length})</div>

                      {transactions.map(tx => (
                        <div key={tx.id} className="p-3 bg-slate-900 border border-slate-800 rounded-xl space-y-2">
                          <div className="flex justify-between items-center">
                            <span className="font-mono text-indigo-400 font-bold">{tx.reference}</span>
                            <span className="text-[10px] px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-400 font-bold">
                              {tx.delivery_status}
                            </span>
                          </div>

                          {tx.items.map((item, idx) => (
                            <div key={idx} className="bg-slate-950 p-2.5 rounded-lg border border-slate-800 space-y-1.5">
                              <div className="flex items-center justify-between">
                                <div className="font-bold text-white">{item.product_name}</div>
                                <button
                                  onClick={() => {
                                    setDisputeTxId(tx.reference);
                                    setMobileScreen('create_dispute');
                                  }}
                                  className="text-[9px] text-amber-400 bg-amber-950/80 hover:bg-amber-900 border border-amber-800/80 px-2 py-0.5 rounded font-bold flex items-center gap-1 cursor-pointer transition"
                                >
                                  <HelpCircle className="w-2.5 h-2.5" /> Reportar
                                </button>
                              </div>
                              <div className="text-[11px] text-amber-300 font-mono font-bold flex items-center justify-between gap-1 flex-wrap">
                                <span>Código: {item.code_delivered}</span>
                                <div className="flex items-center gap-1">
                                  <button
                                    onClick={() => handleCopy(item.code_delivered, item.code_delivered)}
                                    className="text-[9px] bg-slate-800 hover:bg-slate-700 px-2 py-1 rounded text-slate-200 font-bold cursor-pointer"
                                  >
                                    {copiedKey === item.code_delivered ? 'Copiado!' : 'Copiar'}
                                  </button>
                                  <button
                                    onClick={() => handleWhatsAppShare(item.product_name, item.code_delivered)}
                                    className="text-[9px] bg-emerald-600 hover:bg-emerald-500 text-white px-2 py-1 rounded font-bold flex items-center gap-1 cursor-pointer transition"
                                  >
                                    <MessageSquare className="w-3 h-3" /> WhatsApp
                                  </button>
                                </div>
                              </div>
                            </div>
                          ))}
                        </div>
                      ))}
                    </div>
                  )}

                  {/* SCREEN 9: ORDER SUCCESS & WHATSAPP SHARE */}
                  {mobileScreen === 'order_success' && lastCompletedOrder && (
                    <div className="space-y-3.5 text-xs animate-in fade-in zoom-in-95 duration-200">
                      <div className="bg-emerald-950/60 border border-emerald-500/40 rounded-2xl p-3.5 text-center space-y-1.5 shadow-xl">
                        <div className="w-10 h-10 bg-emerald-500/20 border border-emerald-400/50 rounded-full flex items-center justify-center mx-auto text-emerald-400 shadow-md">
                          <CheckCircle2 className="w-6 h-6" />
                        </div>
                        <div>
                          <h3 className="text-xs font-bold text-white">✅ Compra Confirmada!</h3>
                          <p className="text-[10px] text-emerald-300 font-mono mt-0.5">{lastCompletedOrder.reference}</p>
                        </div>
                      </div>

                      <div className="bg-slate-900 border border-slate-800 rounded-2xl p-3.5 space-y-3 shadow-xl">
                        <div className="flex items-center gap-2.5 pb-2.5 border-b border-slate-800">
                          <div className="w-9 h-9 rounded-xl bg-indigo-600/20 border border-indigo-500/40 flex items-center justify-center text-indigo-400 font-bold text-base shrink-0">
                            🎁
                          </div>
                          <div className="min-w-0">
                            <span className="text-[9px] font-bold text-indigo-400 uppercase tracking-wider block">Gift Card Entregue</span>
                            <h4 className="text-xs font-bold text-white truncate">{lastCompletedOrder.product_name}</h4>
                          </div>
                        </div>

                        <div className="bg-slate-950 border border-amber-500/30 rounded-xl p-2.5 space-y-1 text-center">
                          <span className="text-[9px] text-slate-400 font-mono uppercase tracking-wider block">Código de Resgate</span>
                          <div className="text-xs font-black font-mono text-amber-300 tracking-wider bg-amber-950/40 py-1.5 px-2 rounded-lg border border-amber-800/50 select-all">
                            {lastCompletedOrder.code_delivered}
                          </div>
                        </div>

                        {/* Action Buttons as requested in design document */}
                        <div className="space-y-2 pt-1">
                          <button
                            onClick={() => handleCopy(lastCompletedOrder.code_delivered, lastCompletedOrder.code_delivered)}
                            className="w-full py-2 bg-slate-800 hover:bg-slate-700 text-white rounded-xl font-bold flex items-center justify-center gap-1.5 cursor-pointer transition text-[11px]"
                          >
                            <Copy className="w-3.5 h-3.5 text-indigo-400" />
                            {copiedKey === lastCompletedOrder.code_delivered ? '📋 Código Copiado!' : '📋 Copiar Código'}
                          </button>

                          <button
                            onClick={() => handleWhatsAppShare(lastCompletedOrder.product_name, lastCompletedOrder.code_delivered)}
                            className="w-full py-2.5 bg-emerald-600 hover:bg-emerald-500 text-white rounded-xl font-bold flex items-center justify-center gap-2 cursor-pointer transition text-xs shadow-lg shadow-emerald-600/30 border border-emerald-400/30"
                          >
                            <MessageSquare className="w-4 h-4" />
                            💬 Partilhar no WhatsApp
                          </button>

                          <div className="grid grid-cols-2 gap-2 pt-1">
                            <button
                              onClick={() => setMobileScreen('catalog')}
                              className="py-2 bg-slate-950 hover:bg-slate-800 border border-slate-800 text-slate-300 rounded-xl font-bold text-[10px] flex items-center justify-center gap-1 cursor-pointer"
                            >
                              <Home className="w-3.5 h-3.5" /> Voltar à Loja
                            </button>
                            <button
                              onClick={() => setMobileScreen('history')}
                              className="py-2 bg-indigo-950/60 hover:bg-indigo-900 border border-indigo-800/60 text-indigo-200 rounded-xl font-bold text-[10px] flex items-center justify-center gap-1 cursor-pointer"
                            >
                              <History className="w-3.5 h-3.5" /> Minhas Compras
                            </button>
                          </div>
                        </div>
                      </div>
                    </div>
                  )}

                  {/* SCREEN 10: CARRINHO DE COMPRAS */}
                  {mobileScreen === 'cart' && (
                    <div className="space-y-3 text-xs animate-in fade-in duration-200">
                      <div className="flex items-center justify-between font-bold text-white pb-1 border-b border-slate-800">
                        <span className="flex items-center gap-1.5">
                          <ShoppingCart className="w-4 h-4 text-indigo-400" /> Carrinho ({totalCartCount})
                        </span>
                        {cartItems.length > 0 && (
                          <button
                            onClick={clearCart}
                            className="text-[10px] text-red-400 hover:text-red-300 font-mono font-normal cursor-pointer"
                          >
                            Limpar Carrinho
                          </button>
                        )}
                      </div>

                      {cartItems.length === 0 ? (
                        <div className="p-8 text-center space-y-3 bg-slate-900/60 border border-slate-800 rounded-2xl">
                          <div className="w-12 h-12 rounded-2xl bg-slate-800 flex items-center justify-center mx-auto text-slate-500">
                            <ShoppingCart className="w-6 h-6" />
                          </div>
                          <div>
                            <h4 className="font-bold text-white text-xs">O seu carrinho está vazio</h4>
                            <p className="text-[10px] text-slate-400 mt-1">Adicione gift cards ou recargas M-Pesa ao carrinho para pagar de uma só vez.</p>
                          </div>
                          <button
                            onClick={() => setMobileScreen('catalog')}
                            className="px-4 py-2 bg-indigo-600 hover:bg-indigo-500 text-white font-bold rounded-xl text-[11px] cursor-pointer transition shadow-md"
                          >
                            Explorar Catálogo
                          </button>
                        </div>
                      ) : (
                        <div className="space-y-3">
                          {/* Cart Item Cards */}
                          <div className="space-y-2">
                            {cartItems.map((item) => {
                              const price = getProductCreditPriceNum(item.product);
                              const itemTotal = price * item.quantity;
                              return (
                                <div
                                  key={item.product.id}
                                  className="bg-slate-900 border border-slate-800 rounded-xl p-3 flex gap-3 items-center"
                                >
                                  <img
                                    src={item.product.image_url}
                                    alt={item.product.name}
                                    className="w-11 h-11 rounded-lg object-cover bg-slate-800 shrink-0"
                                  />
                                  <div className="flex-1 min-w-0">
                                    <h4 className="font-bold text-white text-xs truncate">{item.product.name}</h4>
                                    <div className="text-[10px] text-slate-400 flex items-center gap-1 mt-0.5">
                                      <span>{price.toFixed(2)} cr / un</span>
                                    </div>
                                    <div className="text-xs font-bold text-emerald-400 mt-1">
                                      Total: {itemTotal.toFixed(2)} cr
                                    </div>
                                  </div>

                                  {/* Quantity Controls */}
                                  <div className="flex flex-col items-end gap-1.5 shrink-0">
                                    <div className="flex items-center gap-1 bg-slate-950 border border-slate-800 rounded-lg p-0.5">
                                      <button
                                        onClick={() => updateCartQuantity(item.product.id, -1)}
                                        className="w-5 h-5 rounded bg-slate-800 hover:bg-slate-700 text-white flex items-center justify-center cursor-pointer font-bold text-xs"
                                      >
                                        -
                                      </button>
                                      <span className="w-5 text-center font-bold text-white text-[11px]">
                                        {item.quantity}
                                      </span>
                                      <button
                                        onClick={() => updateCartQuantity(item.product.id, 1)}
                                        className="w-5 h-5 rounded bg-slate-800 hover:bg-slate-700 text-white flex items-center justify-center cursor-pointer font-bold text-xs"
                                      >
                                        +
                                      </button>
                                    </div>
                                    <button
                                      onClick={() => removeFromCart(item.product.id)}
                                      className="text-[10px] text-red-400 hover:text-red-300 flex items-center gap-0.5 cursor-pointer"
                                    >
                                      <Trash2 className="w-3 h-3" /> Remover
                                    </button>
                                  </div>
                                </div>
                              );
                            })}
                          </div>

                          {/* Order Summary & Wallet Balance */}
                          <div className="bg-slate-900 border border-slate-800 rounded-2xl p-3.5 space-y-2.5">
                            <div className="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Resumo do Checkout</div>
                            <div className="space-y-1 text-xs">
                              <div className="flex justify-between text-slate-300">
                                <span>Total de Produtos:</span>
                                <span className="font-bold text-white">{totalCartCount} itens</span>
                              </div>
                              <div className="flex justify-between text-slate-300">
                                <span>Saldo na Carteira:</span>
                                <span className="font-bold text-emerald-400">{balanceCredit.toFixed(2)} cr</span>
                              </div>
                              <div className="flex justify-between text-white font-bold text-sm pt-2 border-t border-slate-800">
                                <span>Total em Créditos:</span>
                                <span className="text-emerald-400">{cartTotalCredits.toFixed(2)} cr</span>
                              </div>
                            </div>

                            {/* Insufficient balance warning */}
                            {balanceCredit < cartTotalCredits && (
                              <div className="p-2.5 bg-amber-950/80 border border-amber-800/80 rounded-xl space-y-1.5 text-amber-200">
                                <div className="flex items-center gap-1.5 text-[11px] font-bold">
                                  <AlertCircle className="w-4 h-4 text-amber-400 shrink-0" /> Saldo Insuficiente em Créditos
                                </div>
                                <p className="text-[10px] text-amber-300/90 leading-tight">
                                  Faltam <strong>{(cartTotalCredits - balanceCredit).toFixed(2)} cr</strong> para concluir a compra.
                                </p>
                                <button
                                  onClick={() => setMobileScreen('credits')}
                                  className="w-full py-1.5 bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold rounded-lg text-[10px] transition cursor-pointer"
                                >
                                  ⚡ Recarregar Créditos (M-Pesa)
                                </button>
                              </div>
                            )}
                          </div>

                          {/* Multi-checkout Action Button */}
                          <button
                            disabled={isCheckoutProcessing || balanceCredit < cartTotalCredits}
                            onClick={handleMultipleCartCheckout}
                            className={`w-full py-3 font-bold rounded-xl transition flex items-center justify-center gap-2 text-xs shadow-lg ${
                              balanceCredit < cartTotalCredits
                                ? 'bg-slate-800 text-slate-500 cursor-not-allowed border border-slate-700'
                                : 'bg-indigo-600 hover:bg-indigo-500 text-white cursor-pointer shadow-indigo-600/30'
                            }`}
                          >
                            {isCheckoutProcessing ? (
                              <>
                                <div className="w-3.5 h-3.5 border-2 border-indigo-400 border-t-transparent rounded-full animate-spin" />
                                <span>A Processar Checkout... (POST /checkout)</span>
                              </>
                            ) : (
                              <span>Pagar {cartTotalCredits.toFixed(2)} cr (Checkout Múltiplo) ➔</span>
                            )}
                          </button>
                        </div>
                      )}
                    </div>
                  )}

                  {/* SCREEN 11: RECLAMAÇÕES / DISPUTAS */}
                  {mobileScreen === 'disputes_list' && (
                    <div className="space-y-3 text-xs animate-in fade-in duration-200">
                      <div className="flex items-center justify-between font-bold text-white pb-1 border-b border-slate-800">
                        <span className="flex items-center gap-1.5">
                          <HelpCircle className="w-4 h-4 text-amber-400" /> Minhas Reclamações ({disputes.length})
                        </span>
                        <button
                          onClick={() => setMobileScreen('create_dispute')}
                          className="px-2.5 py-1 bg-amber-500/20 hover:bg-amber-500/30 border border-amber-500/40 text-amber-300 rounded-lg text-[10px] font-bold cursor-pointer transition flex items-center gap-1"
                        >
                          <Plus className="w-3 h-3" /> Reportar
                        </button>
                      </div>

                      {disputes.length === 0 ? (
                        <div className="p-8 text-center space-y-3 bg-slate-900/60 border border-slate-800 rounded-2xl">
                          <div className="w-12 h-12 rounded-2xl bg-slate-800 flex items-center justify-center mx-auto text-slate-500">
                            <HelpCircle className="w-6 h-6" />
                          </div>
                          <div>
                            <h4 className="font-bold text-white text-xs">Nenhuma Reclamação Registada</h4>
                            <p className="text-[10px] text-slate-400 mt-1">Se tiver problemas com algum pagamento ou código, pode reportar aqui.</p>
                          </div>
                          <button
                            onClick={() => setMobileScreen('create_dispute')}
                            className="px-4 py-2 bg-amber-600 hover:bg-amber-500 text-slate-950 font-bold rounded-xl text-[11px] cursor-pointer transition shadow-md"
                          >
                            Abrir Reclamação
                          </button>
                        </div>
                      ) : (
                        <div className="space-y-2.5">
                          {disputes.map((dis) => {
                            const statusLabels: Record<Dispute['status'], { label: string; color: string }> = {
                              open: { label: 'Aberto ⏳', color: 'bg-amber-500/20 text-amber-300 border-amber-500/40' },
                              under_review: { label: 'Em Análise 🔍', color: 'bg-indigo-500/20 text-indigo-300 border-indigo-500/40' },
                              resolved_refunded: { label: 'Reembolsado ✅', color: 'bg-emerald-500/20 text-emerald-300 border-emerald-500/40' },
                              resolved_resent: { label: 'Código Re-enviado 🔑', color: 'bg-emerald-500/20 text-emerald-300 border-emerald-500/40' },
                              resolved_rejected: { label: 'Rejeitado ❌', color: 'bg-red-500/20 text-red-300 border-red-500/40' }
                            };

                            const typeNames: Record<Dispute['dispute_type'], string> = {
                              payment_not_confirmed: 'Pagamento não confirmado',
                              code_not_received: 'Código não recebido',
                              wrong_amount: 'Valor cobrado errado',
                              expired_code: 'Código expirado',
                              other: 'Outro problema'
                            };

                            const currentStatus = statusLabels[dis.status] || statusLabels.open;

                            return (
                              <div key={dis.id} className="bg-slate-900 border border-slate-800 rounded-xl p-3 space-y-2">
                                <div className="flex items-center justify-between">
                                  <span className="font-mono font-bold text-amber-400 text-xs">{dis.reference}</span>
                                  <span className={`text-[9px] px-2 py-0.5 rounded border font-bold ${currentStatus.color}`}>
                                    {currentStatus.label}
                                  </span>
                                </div>

                                <div className="bg-slate-950 p-2.5 rounded-lg border border-slate-800 space-y-1 text-[11px]">
                                  <div className="text-slate-400 font-medium">
                                    Tipo: <strong className="text-slate-200">{typeNames[dis.dispute_type]}</strong>
                                  </div>
                                  {dis.transaction_ref && (
                                    <div className="text-slate-400 font-mono text-[10px]">
                                      Transação: <span className="text-indigo-300">{dis.transaction_ref}</span>
                                    </div>
                                  )}
                                  <div className="text-slate-200 mt-1 leading-snug font-sans bg-slate-900/80 p-2 rounded border border-slate-800">
                                    "{dis.description}"
                                  </div>
                                  {dis.admin_response && (
                                    <div className="mt-2 p-2 bg-indigo-950/60 border border-indigo-800/60 rounded text-indigo-200 text-[10px] space-y-0.5">
                                      <span className="font-bold text-indigo-300 block">Resposta da Equipa KaregaAki:</span>
                                      <p>{dis.admin_response}</p>
                                    </div>
                                  )}
                                </div>
                              </div>
                            );
                          })}
                        </div>
                      )}
                    </div>
                  )}

                  {/* SCREEN 12: CRIAR RECLAMAÇÃO */}
                  {mobileScreen === 'create_dispute' && (
                    <div className="space-y-3.5 text-xs animate-in fade-in duration-200">
                      <div className="flex items-center gap-2 font-bold text-white pb-1 border-b border-slate-800">
                        <button
                          onClick={() => setMobileScreen('disputes_list')}
                          className="p-1 rounded bg-slate-900 text-slate-400 hover:text-white cursor-pointer"
                        >
                          <ChevronLeft className="w-4 h-4" />
                        </button>
                        <span>Abrir Nova Reclamação (`POST /disputes`)</span>
                      </div>

                      <div className="bg-slate-900 border border-slate-800 rounded-2xl p-4 space-y-3">
                        {/* Transaction ID Optional Field */}
                        <div className="space-y-1">
                          <label className="text-[10px] text-slate-400 font-bold uppercase">Referência da Transação (Opcional)</label>
                          <select
                            value={disputeTxId}
                            onChange={(e) => setDisputeTxId(e.target.value)}
                            className="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-white"
                          >
                            <option value="">Nenhuma / Reclamação Geral</option>
                            {transactions.map(t => (
                              <option key={t.id} value={t.reference}>
                                {t.reference} - {t.total_credit} cr
                              </option>
                            ))}
                          </select>
                        </div>

                        {/* Dispute Type Field */}
                        <div className="space-y-1">
                          <label className="text-[10px] text-slate-400 font-bold uppercase">Tipo de Problema (`dispute_type`)</label>
                          <select
                            value={disputeType}
                            onChange={(e) => setDisputeType(e.target.value as Dispute['dispute_type'])}
                            className="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-white"
                          >
                            <option value="payment_not_confirmed">Pagamento não confirmado</option>
                            <option value="code_not_received">Código não recebido</option>
                            <option value="wrong_amount">Valor cobrado errado</option>
                            <option value="expired_code">Código expirado / inválido</option>
                            <option value="other">Outro assunto</option>
                          </select>
                        </div>

                        {/* Description Field */}
                        <div className="space-y-1">
                          <label className="text-[10px] text-slate-400 font-bold uppercase">Descrição do Problema</label>
                          <textarea
                            rows={3}
                            value={disputeDesc}
                            onChange={(e) => setDisputeDesc(e.target.value)}
                            placeholder="Ex: Fiz o pagamento de 100 MZN via M-Pesa mas os créditos ainda não entraram no meu saldo..."
                            className="w-full bg-slate-950 border border-slate-800 rounded-xl p-3 text-xs text-white focus:outline-none focus:border-amber-500"
                          />
                        </div>

                        <button
                          onClick={handleCreateDisputeSubmit}
                          className="w-full py-2.5 bg-amber-600 hover:bg-amber-500 text-slate-950 font-bold rounded-xl cursor-pointer transition shadow-lg shadow-amber-600/20 flex items-center justify-center gap-1.5 text-xs"
                        >
                          <Send className="w-3.5 h-3.5" /> Enviar Reclamação
                        </button>
                      </div>
                    </div>
                  )}

                  {/* SCREEN 13: DETALHES DO PRODUTO */}
                  {mobileScreen === 'product_detail' && selectedDetailProduct && (
                    <div className="space-y-3.5 text-xs animate-in fade-in duration-200">
                      <div className="flex items-center gap-2 font-bold text-white pb-1 border-b border-slate-800">
                        <button
                          onClick={() => setMobileScreen('catalog')}
                          className="p-1 rounded bg-slate-900 text-slate-400 hover:text-white cursor-pointer"
                        >
                          <ChevronLeft className="w-4 h-4" />
                        </button>
                        <span>Detalhes do Produto</span>
                      </div>

                      <div className="bg-slate-900 border border-slate-800 rounded-2xl p-4 space-y-3">
                        <div className="relative">
                          <img
                            src={selectedDetailProduct.image_url}
                            alt={selectedDetailProduct.name}
                            className="w-full h-36 rounded-xl object-cover bg-slate-800"
                          />
                          {selectedDetailProduct.stock_available <= 0 && (
                            <div className="absolute inset-0 bg-black/70 rounded-xl flex items-center justify-center">
                              <span className="text-xs font-black text-red-400 uppercase tracking-widest bg-red-950 px-3 py-1 rounded-lg border border-red-800">
                                Esgotado no Fornecedor
                              </span>
                            </div>
                          )}
                        </div>

                        <div>
                          <span className="text-[9px] font-bold text-indigo-400 uppercase tracking-wider block">
                            {selectedDetailProduct.category_name}
                          </span>
                          <h3 className="text-sm font-bold text-white mt-0.5">{selectedDetailProduct.name}</h3>
                          <p className="text-[11px] text-slate-300 mt-1 leading-relaxed">{selectedDetailProduct.description}</p>
                        </div>

                        <div className="p-3 bg-slate-950 rounded-xl border border-slate-800 flex items-center justify-between">
                          <div>
                            <span className="text-[10px] text-slate-400 uppercase font-bold block">Preço do Produto</span>
                            <span className="text-sm font-bold text-emerald-400">{selectedDetailProduct.credit_price} cr</span>
                          </div>
                          <div className="text-right">
                            <span className="text-[10px] text-slate-400 uppercase font-bold block">Disponibilidade</span>
                            <span className={`text-xs font-bold ${selectedDetailProduct.stock_available > 0 ? 'text-emerald-400' : 'text-red-400'}`}>
                              {selectedDetailProduct.stock_available > 0 ? `${selectedDetailProduct.stock_available} unidades` : 'Esgotado'}
                            </span>
                          </div>
                        </div>

                        <div className="grid grid-cols-2 gap-2 pt-1">
                          <button
                            disabled={selectedDetailProduct.stock_available <= 0}
                            onClick={() => addToCart(selectedDetailProduct, 1)}
                            className="py-2.5 bg-slate-800 hover:bg-slate-700 disabled:opacity-50 text-white font-bold rounded-xl cursor-pointer transition flex items-center justify-center gap-1.5"
                          >
                            <ShoppingCart className="w-4 h-4 text-indigo-400" /> + Carrinho
                          </button>
                          <button
                            disabled={selectedDetailProduct.stock_available <= 0}
                            onClick={() => {
                              setCartProduct(selectedDetailProduct);
                              setMobileScreen('checkout');
                            }}
                            className="py-2.5 bg-indigo-600 hover:bg-indigo-500 disabled:opacity-50 text-white font-bold rounded-xl cursor-pointer transition flex items-center justify-center gap-1"
                          >
                            Comprar Já ➔
                          </button>
                        </div>
                      </div>
                    </div>
                  )}

                  {/* SCREEN 6: PROFILE / KYC */}
                  {mobileScreen === 'kyc' && (
                    <div className="space-y-4 text-xs animate-in fade-in duration-200">
                      {/* User Session Info Card */}
                      <div className="p-3.5 bg-slate-900 border border-slate-800 rounded-2xl space-y-2">
                        <div className="flex items-center justify-between">
                          <div className="flex items-center gap-2">
                            <div className="w-8 h-8 rounded-full bg-indigo-600 text-white font-bold flex items-center justify-center text-xs">
                              {user.phone ? user.phone.substring(0, 2) : '84'}
                            </div>
                            <div>
                              <div className="font-bold text-white text-xs">{user.phone || '841234567'}</div>
                              <div className="text-[10px] text-emerald-400 font-mono flex items-center gap-1">
                                <span className="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse" /> Sessão Ativa (Autenticado)
                              </div>
                            </div>
                          </div>
                          <span className="text-[9px] font-mono text-slate-400 bg-slate-950 px-2 py-0.5 rounded border border-slate-800">
                            Secure Storage: JWT
                          </span>
                        </div>
                      </div>

                      <div className="p-3.5 bg-gradient-to-tr from-indigo-900 to-blue-900 rounded-2xl space-y-1 text-white shadow-lg">
                        <div className="text-[10px] uppercase font-bold text-indigo-200">Nível KYC Atual</div>
                        <div className="text-xl font-bold">{user.kyc_level}</div>
                        <div className="text-[11px] text-indigo-200">Limite Diário: {user.limit_mzn} MZN</div>
                      </div>

                      {/* KYC Levels Table */}
                      <div className="p-3 bg-slate-900 border border-slate-800 rounded-xl space-y-2">
                        <div className="font-bold text-white">Níveis de KYC do KaregaAki</div>
                        <div className="space-y-1 text-[10px]">
                          <div className="flex justify-between p-1.5 bg-slate-950 rounded">
                            <span>Básico</span>
                            <span className="text-slate-400">500 MZN (Só Telefone)</span>
                          </div>
                          <div className="flex justify-between p-1.5 bg-slate-950 rounded text-emerald-400">
                            <span>Verificado</span>
                            <span>5.000 MZN (BI + Selfie)</span>
                          </div>
                          <div className="flex justify-between p-1.5 bg-slate-950 rounded text-amber-400">
                            <span>Premium</span>
                            <span>50.000 MZN (Score {'>'} 70)</span>
                          </div>
                        </div>
                      </div>

                      {/* Submit Documents Form */}
                      <div className="p-3 bg-slate-900 border border-slate-800 rounded-xl space-y-2">
                        <div className="font-bold text-white">Submeter BI / Documento</div>
                        <input
                          type="text"
                          placeholder="Número do BI (Ex: 123456789AB)"
                          value={biInput}
                          onChange={(e) => setBiInput(e.target.value)}
                          className="w-full bg-slate-950 border border-slate-800 rounded px-2.5 py-1.5 text-xs text-white"
                        />
                        <button
                          onClick={() => {
                            if (biInput.trim()) {
                              setUser(prev => ({ ...prev, kyc_level: 'Verificado', limit_mzn: 5000, bi_number: biInput }));
                              alert('Documentos aceites! Nível KYC atualizado para VERIFICADO (5.000 MZN limite).');
                            }
                          }}
                          className="w-full py-2 bg-indigo-600 hover:bg-indigo-500 text-white font-bold rounded cursor-pointer"
                        >
                          Submeter Documento BI ➔
                        </button>
                      </div>

                      {/* LOGOUT BUTTON */}
                      <div className="pt-2">
                        <button
                          onClick={() => {
                            setIsLoggedIn(false);
                            setAuthPin('');
                            setAuthMode('login');
                            setMobileScreen('auth');
                            triggerLocalNotification(
                              'Sessão Terminada 🔒',
                              'O token JWT foi removido do FlutterSecureStorage e a sessão foi encerrada com sucesso.'
                            );
                          }}
                          className="w-full py-2.5 bg-red-950/80 hover:bg-red-900 border border-red-800/80 text-red-200 rounded-xl font-bold flex items-center justify-center gap-2 cursor-pointer transition shadow-lg"
                        >
                          <LogOut className="w-4 h-4 text-red-400" /> Sair da Conta (Logout)
                        </button>
                        <p className="text-[10px] text-slate-500 text-center mt-1.5 font-mono">
                          Apaga o token em FlutterSecureStorage, limpa o AuthProvider e redireciona para LoginScreen
                        </p>
                      </div>
                    </div>
                  )}

                  {/* SCREEN 7: WALLET & MOVEMENTS */}
                  {mobileScreen === 'wallet' && (
                    <div className="space-y-4 text-xs">
                      <div className="p-4 bg-gradient-to-tr from-emerald-900 to-teal-900 rounded-2xl text-white space-y-1">
                        <div className="text-[10px] uppercase font-bold text-emerald-200">Saldo da Carteira</div>
                        <div className="text-2xl font-black">{balanceCredit.toFixed(2)} cr</div>
                        <p className="text-[10px] text-emerald-200">1 Crédito = 1 MZN</p>
                      </div>

                      <div className="space-y-2">
                        <div className="font-bold text-white">Histórico de Movimentos</div>
                        {walletMovements.map(m => (
                          <div key={m.id} className="p-2.5 bg-slate-900 border border-slate-800 rounded-xl flex justify-between items-center">
                            <div>
                              <div className="font-bold text-white">{m.description}</div>
                              <div className="text-[10px] text-slate-500">{m.created_at}</div>
                            </div>
                            <span className={`font-mono font-bold ${m.amount > 0 ? 'text-emerald-400' : 'text-red-400'}`}>
                              {m.amount > 0 ? `+${m.amount.toFixed(2)}` : m.amount.toFixed(2)} cr
                            </span>
                          </div>
                        ))}
                      </div>
                    </div>
                  )}

                  {/* SCREEN 8: PRODUCT DETAIL & STOCK CHECK */}
                  {mobileScreen === 'product_detail' && selectedDetailProduct && (
                    <div className="space-y-4 text-xs animate-in fade-in duration-200">
                      <div className="flex items-center justify-between border-b border-slate-800/80 pb-2">
                        <button
                          onClick={() => setMobileScreen('catalog')}
                          className="flex items-center gap-1 text-indigo-400 hover:text-indigo-300 font-bold text-[11px] cursor-pointer"
                        >
                          <ChevronLeft className="w-4 h-4" /> Voltar ao Catálogo
                        </button>
                        <span className="text-[10px] text-slate-500 font-mono">ProductDetailScreen</span>
                      </div>

                      <div className="bg-slate-900 border border-slate-800 rounded-2xl p-4 space-y-3 shadow-xl">
                        <div className="relative">
                          <img
                            src={selectedDetailProduct.image_url}
                            alt={selectedDetailProduct.name}
                            className="w-full h-36 rounded-xl object-cover bg-slate-800"
                          />
                          {selectedDetailProduct.stock_available <= 0 ? (
                            <span className="absolute top-2 right-2 px-2.5 py-1 bg-red-950/95 text-red-300 border border-red-500/80 rounded-lg text-[10px] font-bold uppercase tracking-wider shadow-lg flex items-center gap-1">
                              <AlertTriangle className="w-3.5 h-3.5 text-red-400" /> Esgotado
                            </span>
                          ) : (
                            <span className="absolute top-2 right-2 px-2.5 py-1 bg-emerald-950/95 text-emerald-300 border border-emerald-500/80 rounded-lg text-[10px] font-bold shadow-lg flex items-center gap-1">
                              <CheckCircle2 className="w-3.5 h-3.5 text-emerald-400" /> {selectedDetailProduct.stock_available} em stock
                            </span>
                          )}
                        </div>

                        <div>
                          <div className="flex items-center justify-between">
                            <span className="text-[10px] font-bold text-indigo-400 uppercase tracking-wider">
                              {selectedDetailProduct.category_name}
                            </span>
                            <span className="text-[10px] text-slate-500 font-mono">ID: {selectedDetailProduct.id.substring(0, 8)}...</span>
                          </div>
                          <h3 className="text-sm font-bold text-white mt-0.5">{selectedDetailProduct.name}</h3>
                          <p className="text-[11px] text-slate-300 mt-1 leading-relaxed bg-slate-950/60 p-2.5 rounded-xl border border-slate-800/80">
                            {selectedDetailProduct.description}
                          </p>
                        </div>

                        <div className="pt-2 border-t border-slate-800 flex items-center justify-between">
                          <span className="text-slate-400 text-[11px]">Preço em Créditos</span>
                          <span className="text-base font-bold text-emerald-400">{selectedDetailProduct.credit_price} cr</span>
                        </div>

                        {/* Banner de Verificação de Stock */}
                        {selectedDetailProduct.stock_available <= 0 ? (
                          <div className="p-3 bg-red-950/80 border border-red-800/80 rounded-xl flex items-start gap-2 text-red-200 text-[11px] leading-relaxed">
                            <AlertCircle className="w-4 h-4 text-red-400 shrink-0 mt-0.5" />
                            <div>
                              <strong className="block font-bold text-red-300 text-xs">Produto Indisponível (Esgotado)</strong>
                              O stock disponível para este produto é zero (0 unidades). O botão de compra foi desabilitado automaticamente.
                            </div>
                          </div>
                        ) : (
                          <div className="p-2.5 bg-emerald-950/40 border border-emerald-800/40 rounded-xl flex items-center gap-2 text-emerald-300 text-[11px]">
                            <CheckCircle className="w-4 h-4 text-emerald-400 shrink-0" />
                            <span>Stock disponível para entrega digital imediata!</span>
                          </div>
                        )}

                        {/* Botão de Compra com Verificação de Stock */}
                        <button
                          disabled={selectedDetailProduct.stock_available <= 0}
                          onClick={() => {
                            if (selectedDetailProduct.stock_available <= 0) return;
                            setCartProduct(selectedDetailProduct);
                            setMobileScreen('checkout');
                          }}
                          className={`w-full py-2.5 rounded-xl font-bold transition flex items-center justify-center gap-2 text-xs ${
                            selectedDetailProduct.stock_available <= 0
                              ? 'bg-slate-800 text-slate-500 border border-slate-700 cursor-not-allowed opacity-90'
                              : 'bg-indigo-600 hover:bg-indigo-500 text-white cursor-pointer shadow-lg shadow-indigo-600/30'
                          }`}
                        >
                          {selectedDetailProduct.stock_available <= 0 ? (
                            <>
                              <Ban className="w-4 h-4 text-red-400" /> Indisponível (Esgotado)
                            </>
                          ) : (
                            <>
                              <ShoppingCart className="w-4 h-4" /> Avançar para Checkout ({selectedDetailProduct.credit_price} cr)
                            </>
                          )}
                        </button>
                      </div>
                    </div>
                  )}

                </div>

                {/* Mobile Bottom Navigation Bar */}
                <div className="bg-slate-950/95 backdrop-blur-md border-t border-slate-800/90 p-2 grid grid-cols-5 gap-1 text-[9px]">
                  <button
                    onClick={() => setMobileScreen('catalog')}
                    className={`flex flex-col items-center gap-1 py-1.5 rounded-xl cursor-pointer transition ${
                      mobileScreen === 'catalog' || mobileScreen === 'product_detail'
                        ? 'bg-indigo-600/20 text-indigo-400 font-bold border border-indigo-500/30 shadow-sm'
                        : 'text-slate-500 hover:text-slate-300'
                    }`}
                  >
                    <ShoppingBag className="w-3.5 h-3.5" />
                    <span>Loja</span>
                  </button>

                  <button
                    onClick={() => setMobileScreen('cart')}
                    className={`relative flex flex-col items-center gap-1 py-1.5 rounded-xl cursor-pointer transition ${
                      mobileScreen === 'cart'
                        ? 'bg-indigo-600/20 text-indigo-400 font-bold border border-indigo-500/30 shadow-sm'
                        : 'text-slate-500 hover:text-slate-300'
                    }`}
                  >
                    <ShoppingCart className="w-3.5 h-3.5" />
                    {totalCartCount > 0 && (
                      <span className="absolute top-1 right-2 bg-indigo-600 text-white font-black text-[8px] rounded-full w-3.5 h-3.5 flex items-center justify-center">
                        {totalCartCount}
                      </span>
                    )}
                    <span>Carrinho</span>
                  </button>

                  <button
                    onClick={() => setMobileScreen('credits')}
                    className={`flex flex-col items-center gap-1 py-1.5 rounded-xl cursor-pointer transition ${
                      mobileScreen === 'credits' || mobileScreen === 'wallet'
                        ? 'bg-indigo-600/20 text-indigo-400 font-bold border border-indigo-500/30 shadow-sm'
                        : 'text-slate-500 hover:text-slate-300'
                    }`}
                  >
                    <CreditCard className="w-3.5 h-3.5" />
                    <span>Créditos</span>
                  </button>

                  <button
                    onClick={() => setMobileScreen('history')}
                    className={`flex flex-col items-center gap-1 py-1.5 rounded-xl cursor-pointer transition ${
                      mobileScreen === 'history' || mobileScreen === 'order_success'
                        ? 'bg-indigo-600/20 text-indigo-400 font-bold border border-indigo-500/30 shadow-sm'
                        : 'text-slate-500 hover:text-slate-300'
                    }`}
                  >
                    <History className="w-3.5 h-3.5" />
                    <span>Compras</span>
                  </button>

                  <button
                    onClick={() => setMobileScreen('kyc')}
                    className={`flex flex-col items-center gap-1 py-1.5 rounded-xl cursor-pointer transition ${
                      mobileScreen === 'kyc' || mobileScreen === 'auth'
                        ? 'bg-indigo-600/20 text-indigo-400 font-bold border border-indigo-500/30 shadow-sm'
                        : 'text-slate-500 hover:text-slate-300'
                    }`}
                  >
                    <UserCheck className="w-3.5 h-3.5" />
                    <span>Perfil</span>
                  </button>
                </div>

              </div>
            </div>

          </div>
        )}

        {/* TAB 2: DART CODE EXPORT */}
        {activeTab === 'dart_export' && (
          <div className="space-y-6">
            <div className="bg-slate-900 border border-slate-800 rounded-2xl p-6 space-y-4">
              <h3 className="text-lg font-bold text-white flex items-center gap-2">
