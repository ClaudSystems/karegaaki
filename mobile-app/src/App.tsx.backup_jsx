                <button
                  onClick={() => handleCopy(`import 'package:flutter_local_notifications/flutter_local_notifications.dart';

class NotificationService {
  static final NotificationService _instance = NotificationService._internal();
  factory NotificationService() => _instance;
  NotificationService._internal();

  final FlutterLocalNotificationsPlugin _notificationsPlugin = FlutterLocalNotificationsPlugin();

  Future<void> init() async {
    const AndroidInitializationSettings androidSettings =
        AndroidInitializationSettings('@mipmap/ic_launcher');

    const DarwinInitializationSettings iosSettings = DarwinInitializationSettings(
      requestAlertPermission: true,
      requestBadgePermission: true,
      requestSoundPermission: true,
    );

    const InitializationSettings initSettings = InitializationSettings(
      android: androidSettings,
      iOS: iosSettings,
    );

    await _notificationsPlugin.initialize(
      initSettings,
      onDidReceiveNotificationResponse: (NotificationResponse response) {
        // Callback acionado ao tocar na notificação
      },
    );
  }

  Future<void> showPurchaseProcessedNotification({
    required String reference,
    required double totalCredit,
  }) async {
    const AndroidNotificationDetails androidDetails = AndroidNotificationDetails(
      'karega_purchases_channel',
      'Compras & Transações',
      channelDescription: 'Notificações de confirmação de compras no KaregaAki',
      importance: Importance.max,
      priority: Priority.high,
      icon: '@mipmap/ic_launcher',
    );

    const NotificationDetails details = NotificationDetails(
      android: androidDetails,
      iOS: DarwinNotificationDetails(),
    );

    await _notificationsPlugin.show(
      DateTime.now().millisecondsSinceEpoch ~/ 1000,
      'Compra Processada com Sucesso! 🛒',
      'A sua compra $reference no valor de \${totalCredit.toStringAsFixed(2)} cr foi confirmada.',
      details,
    );
  }

  Future<void> showCodeDeliveredNotification({
    required String productName,
    required String code,
  }) async {
    const AndroidNotificationDetails androidDetails = AndroidNotificationDetails(
      'karega_codes_channel',
      'Entrega de Códigos',
      channelDescription: 'Notificações com códigos de resgate entregues',
      importance: Importance.max,
      priority: Priority.high,
      icon: '@mipmap/ic_launcher',
    );

    const NotificationDetails details = NotificationDetails(
      android: androidDetails,
      iOS: DarwinNotificationDetails(),
    );

    await _notificationsPlugin.show(
      (DateTime.now().millisecondsSinceEpoch ~/ 1000) + 1,
      'Código Entregue com Sucesso! 🎁',
      'O seu código para $productName é: $code. Abra a app para copiar.',
      details,
    );
  }
}`, 'notification_code')}
