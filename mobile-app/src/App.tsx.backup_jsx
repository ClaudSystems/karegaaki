} from 'lucide-react';

// --- TYPES ---
interface Category {
  id: string;
  name: string;
  slug: string;
}

interface Product {
  id: string;
  name: string;
  slug: string;
  description: string;
  category_id: string;
  category_name: string;
  image_url: string;
  credit_price: string;
  is_active: boolean;
  stock_available: number;
}

interface CreditPackage {
  id: string;
  name: string;
  amount_mzn: number;
  credit_received: number;
  bonus_credit: number;
  is_popular?: boolean;
}

interface TransactionItem {
  product_id: string;
  product_name: string;
  quantity: number;
  unit_credit_price: number;
  code_delivered: string;
}

interface Transaction {
  id: string;
  reference: string;
  total_credit: number;
  payment_status: 'confirmed' | 'pending' | 'failed';
  delivery_status: 'delivered' | 'processing';
  payment_method: string;
  items: TransactionItem[];
  created_at: string;
}

interface WalletMovement {
  id: string;
  type: 'credit_purchase' | 'purchase_spent' | 'bonus' | 'refund';
  amount: number;
  description: string;
  created_at: string;
}

interface UserProfile {
  id: string;
  phone: string;
  full_name: string;
  kyc_level: 'Básico' | 'Verificado' | 'Premium';
  limit_mzn: number;
  daily_tx_limit: number;
  bi_number?: string;
  is_verified: boolean;
}

interface CartItem {
  product: Product;
  quantity: number;
}

interface Dispute {
  id: string;
  reference: string;
  transaction_id?: string;
  transaction_ref?: string;
  dispute_type: 'payment_not_confirmed' | 'code_not_received' | 'wrong_amount' | 'expired_code' | 'other';
  description: string;
  status: 'open' | 'under_review' | 'resolved_refunded' | 'resolved_resent' | 'resolved_rejected';
  created_at: string;
  admin_response?: string;
}

// --- INITIAL DATA ---
const CATEGORIES: Category[] = [
  { id: 'cat-all', name: 'Todos', slug: 'todos' },
  { id: 'cat-gift', name: 'Gift Cards', slug: 'gift-cards' },
